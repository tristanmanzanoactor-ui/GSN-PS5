<script id="rbxtest-profile-route">
/* Routes every profile link (/users/profile or /users/<id>/profile, relative or on any host,
   including the workers.dev address the page is served from) to the local profileview.devtools page. */
(function () {
    var TARGET = 'profileview.devtools';
    function isProfile(a) {
        var h = a.getAttribute && a.getAttribute('href');
        if (!h || h === TARGET) return false;
        var path;
        try { path = new URL(h, window.location.href).pathname; } catch (e) { return false; }
        return /^\/users\/(\d+\/)?profile\/?$/.test(path);
    }
    function patch(root) {
        (root.querySelectorAll ? root.querySelectorAll('a[href*="/users/"]') : []).forEach(function (a) {
            if (isProfile(a)) a.setAttribute('href', TARGET);
        });
    }
    document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a || !isProfile(a)) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.ctrlKey || e.metaKey || a.target === '_blank') window.open(TARGET, '_blank');
        else window.location.href = TARGET;
    }, true);
    patch(document);
    new MutationObserver(function () { patch(document); })
        .observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script id="rbxtest-build">
/* Build stamp: open any page with ?build on the end (e.g. profileview.devtools?build) to see which version is being served. */
(function () {
    var BUILD = 'r9-2026-10-04';
    try { console.log('FigureBlox build', BUILD); } catch (e) {}
    if (!/[?&]build\b/.test(location.search)) return;
    var b = document.createElement('div');
    b.textContent = 'build ' + BUILD;
    b.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:2147483647;background:#111;color:#0f0;font:12px monospace;padding:4px 8px;border-radius:4px;';
    document.body.appendChild(b);
})();
</script>
<script id="rbxtest-robux">
document.documentElement.classList.add('rbx-auth-pending');
document.addEventListener('DOMContentLoaded', function () {
    rbxShell.requireLogin(function (acc, key) { init(); });
});
function init() {
    var S = window.rbxShell, root = document.getElementById('robux-root');
    var PKGS = [[24000,22500,1500],[11000,10000,1000],[5250,4500,750],[3625,3150,475,1],[2000,1700,300],[1500,1200,300],[1000,800,200],[500,400,100],[270,240,30]];
    var TIERS = [['FigureBlox Plus','',null,['icon-regular-tag','Up to 20% off on items and avatars'],['icon-regular-controller','Free private servers'],['icon-regular-robux','Send Robux for free'],['icon-regular-paint-brush','Customize profile and app theme']],
        ['Plus 500','$8.99','$9.98',['icon-regular-roblox-plus','Everything in Plus'],['icon-regular-robux','+500 Robux every month'],['icon-regular-pig','$9.98 total value']],
        ['Plus 1000','$12.99','$14.98',['icon-regular-roblox-plus','Everything in Plus'],['icon-regular-robux','+1,000 Robux every month'],['icon-regular-pig','$14.98 total value']],
        ['Plus 2000','$21.99','$24.98',['icon-regular-roblox-plus','Everything in Plus'],['icon-regular-robux','+2,000 Robux every month'],['icon-regular-pig','$24.98 total value']]];
    var FAQ = [['What are Robux?','Robux is the virtual currency used on FigureBlox to buy items and upgrades for your avatar and experiences.'],
        ['Where are my Robux?','Your Robux balance is shown at the top of every page and at the top of this page.'],
        ['Do Robux expire?','No, Robux do not expire.'],
        ['How to redeem your gift card?','Gift card redemption is coming soon.']];
    var ICON = function (c, s) { return '<span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon ' + c + ' size-[var(--icon-size-' + s + ')]"></span>'; };
    var BTN = 'foundation-web-button relative clip group/interactable focus-visible:outline-focus disabled:outline-none cursor-pointer relative flex items-center justify-center stroke-none padding-y-none select-none radius-medium text-label-medium height-1000 padding-x-medium ';
    var LAYER = '<div aria-hidden="true" data-testid="foundation-web-state-layer" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div>';
    var h = '<div id="robux-redesign-page" class="robux-redesign-page buy-robux-page"><div class="flex flex-col items-center">';
    h += '<div class="rbxtest-robux-top"><div class="bal">' + ICON('icon-filled-robux', 'large') + '<span class="num" id="rbxtest-balance">0</span>' +
        '<button type="button" id="rbxtest-send-btn" class="foundation-web-button relative clip group/interactable cursor-pointer flex items-center justify-center stroke-none select-none radius-medium text-label-medium height-800 padding-x-small bg-action-standard content-action-standard shrink-0" style="padding-right:12px">' + LAYER +
        '<span class="flex items-center min-width-0 gap-xsmall">' + ICON('icon-regular-arrow-up-from-line', 'small') + '<span class="padding-y-xsmall text-truncate-end text-no-wrap">Send</span></span></button></div></div>';
    h += '<div class="buy-robux-content"><h1 class="text-section-title content-emphasis" style="text-align:center">Enjoy up to 25% more Robux</h1>';
    h += '<div class="self-stretch flex flex-col items-start gap-medium" data-section-type="PAYMENTS_PRODUCT_SECTION_TYPE_PRODUCTS_LIST"><div class="buy-robux-section-header text-heading-large">Robux packages</div><div class="radius-large robux-section bg-surface-100">';
    PKGS.forEach(function (p) {
        h += '<div data-robux="' + p[0] + '" class="self-stretch flex flex-row justify-between items-center gap-small"><div class="flex flex-row items-center gap-small wrap" style="min-width:0;flex:1">' +
            '<div class="flex flex-row items-center gap-xsmall content-emphasis" style="min-width:150px">' + ICON('icon-filled-robux', 'xlarge') + '<span class="text-heading-large">' + p[0].toLocaleString('en-US') + '</span></div>' +
            '<div class="flex flex-row items-center gap-xsmall relative content-muted"><div class="robux-amount-strike-through"></div>' + ICON('icon-filled-robux', 'large') + '<span class="text-heading-small">' + p[1].toLocaleString('en-US') + '</span></div>' +
            '<div class="foundation-web-badge flex items-center radius-circle height-600 padding-x-small bg-shift-200"><span class="text-label-small padding-x-xxsmall content-emphasis">+ ' + p[2].toLocaleString('en-US') + ' more</span></div>' +
            (p[3] ? '<div class="foundation-web-badge flex items-center radius-circle height-600 padding-x-small bg-shift-200">' + ICON('icon-regular-circle-star', 'xsmall') + '<span class="text-label-small padding-x-xxsmall content-emphasis">For you</span></div>' : '') +
            '</div><button type="button" class="' + BTN + (p[3] ? 'bg-action-emphasis content-action-emphasis' : 'bg-action-standard content-action-standard') + ' shrink-0" style="min-width:140px" data-free="' + p[0] + '">' + LAYER + '<span class="padding-y-xsmall"><span class="price-tag robux-price-tag">Free</span></span></button></div>';
    });
    h += '</div></div>';
    h += '<div class="self-stretch flex flex-col items-start gap-medium" data-section-type="PAYMENTS_PRODUCT_SECTION_TYPE_SUBSCRIPTION_V2"><div class="buy-robux-section-header text-heading-large flex flex-row items-center gap-medium">' + ICON('icon-regular-roblox-plus', 'xlarge') + 'New on FigureBlox</div><div class="carousel-track-fb self-stretch">';
    TIERS.forEach(function (t, i) {
        h += '<div class="shrink-0 flex flex-col" style="width:242px"><div class="radius-large padding-medium flex flex-col items-stretch justify-between gap-small stroke-standard stroke-default height-full"><div class="flex flex-row items-center justify-between gap-large"><h3 class="text-label-large content-emphasis">' + t[0] + '</h3><div class="flex flex-row gap-small">' +
            (t[2] ? '<span class="text-title-medium content-muted" style="text-decoration:line-through">' + t[2] + '</span>' : '') + '<span class="text-title-medium content-emphasis">' + (t[1] || '$4.99') + '</span></div></div><ul class="flex flex-col gap-medium padding-y-small" style="list-style:none;padding-inline-start:0;margin-block:0">';
        t.slice(3).forEach(function (b) { h += '<li class="flex flex-row items-center gap-medium">' + ICON(b[0], 'medium') + '<span class="text-body-medium content-default">' + b[1] + '</span></li>'; });
        h += '</ul><button type="button" class="' + BTN + 'bg-action-standard content-action-standard width-full" data-soon>' + LAYER + '<span class="padding-y-xsmall">' + (t[1] || '$4.99') + '/month</span></button></div></div>';
    });
    h += '</div></div>';
    h += '<div class="self-stretch flex flex-col items-start gap-medium"><div class="buy-robux-section-header text-heading-large">FAQ</div><div class="self-stretch flex flex-col items-stretch gap-medium">';
    FAQ.forEach(function (q, i) {
        h += '<div class="radius-medium stroke-standard stroke-default padding-x-medium padding-y-small"><div role="button" aria-expanded="false" tabindex="0" data-faq="' + i + '" class="width-full cursor-pointer flex flex-row items-center justify-between height-1000 content-default"><span class="text-title-medium">' + q[0] + '</span>' + ICON('icon-regular-chevron-large-down', 'medium') + '</div><div class="faq-panel content-default" hidden>' + q[1] + '</div></div>';
    });
    h += '</div></div></div></div></div>';
    root.innerHTML = h;

    function refresh() { var el = document.getElementById('rbxtest-balance'); if (el) el.textContent = S.fmtRobux(S.getRobux()); var m = document.getElementById('rbxtest-sheet-bal'); if (m) m.textContent = S.fmtRobux(S.getRobux()); }
    refresh(); window.addEventListener('rbx-robux', refresh);

    // Free Robux: every click adds that package's Robux to the balance
    root.addEventListener('click', function (e) {
        var b = e.target.closest('[data-free]');
        if (b) { S.addRobux(parseInt(b.getAttribute('data-free'), 10)); return; }
        if (e.target.closest('[data-soon]')) { S.toast('Coming soon'); return; }
        var q = e.target.closest('[data-faq]');
        if (q) { var p = q.parentElement.querySelector('.faq-panel'); var open = q.getAttribute('aria-expanded') === 'true'; q.setAttribute('aria-expanded', String(!open)); p.hidden = open; }
    });

    // ---------- Send Robux sheet ----------
    var overlay = document.createElement('div');
    overlay.id = 'rbxtest-send-overlay'; overlay.hidden = true;
    overlay.innerHTML = '<div role="dialog" aria-labelledby="send-title" data-state="open" data-testid="fui-base-sheet-content" class="fui-base-sheet-content relative bg-surface-100 stroke-muted stroke-standard shadow-transient-high flex flex-col clip" tabindex="-1" style="pointer-events:auto">' +
        '<div class="relative bg-surface-100 shrink-0 padding-left-xlarge padding-right-small padding-y-small flex items-center justify-between" style="padding-top:11px"><div class="flex items-center"><h2 id="send-title" class="text-heading-small margin-none"><div class="flex flex-row items-center gap-xsmall">' + ICON('icon-regular-roblox-plus', 'large') + 'Send Robux</div></h2></div>' +
        '<div class="flex items-center gap-xxsmall"><div class="flex flex-row items-center gap-xsmall">' + ICON('icon-regular-robux', 'small') + '<span class="text-label-medium content-emphasis" id="rbxtest-sheet-bal">0</span></div><div class="fui-sheet-close-affordance-container"><button type="button" aria-label="Close" id="rbxtest-send-close" class="foundation-web-icon-button relative clip group/interactable cursor-pointer flex items-center justify-center padding-none stroke-none select-none size-1000 radius-medium bg-action-link">' + LAYER + '<span class="icon icon-regular-x size-600 content-emphasis"></span></button></div></div></div>' +
        '<div class="send-robux-search-row shrink-0 bg-surface-100 padding-x-xlarge padding-top-xsmall padding-bottom-large"><div class="flex width-full flex-col gap-small send-robux-search-input"><div class="foundation-web-input flex items-center width-full relative clip stroke-standard bg-none height-1000 radius-circle padding-x-medium gap-x-small stroke-contrast-alpha focus-within:stroke-system-emphasis"><div class="flex shrink-0 items-center">' + ICON('icon-regular-magnifying-glass', 'medium') + '</div>' +
        '<input type="search" id="rbxtest-send-input" placeholder="Search" class="width-full min-width-0 padding-none bg-none stroke-none outline-none content-emphasis text-body-medium" name="user-search" maxlength="30" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Search" value=""></div></div></div>' +
        '<div class="scroll-y padding-x-xlarge hide-scrollbar clip-x send-robux-sheet-body-inset" style="flex:1;overflow-y:auto"><div class="flex flex-col padding-bottom-large" id="rbxtest-send-results"></div></div></div>';
    document.body.appendChild(overlay);
    var input = overlay.querySelector('#rbxtest-send-input'), results = overlay.querySelector('#rbxtest-send-results');
    function openSheet() { results.innerHTML = ''; input.value = ''; refresh(); overlay.hidden = false; setTimeout(function () { input.focus(); }, 30); }
    function closeSheet() { overlay.hidden = true; }
    document.getElementById('rbxtest-send-btn').addEventListener('click', openSheet);
    overlay.querySelector('#rbxtest-send-close').addEventListener('click', closeSheet);
    overlay.addEventListener('mousedown', function (e) { if (e.target === overlay) closeSheet(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) closeSheet(); });

    function matches(q) {
        var lq = q.toLowerCase(), out = [], seen = {};
        function add(display, handle, img) { var k = handle.toLowerCase(); if (seen[k]) return; seen[k] = 1; out.push({ display: display, handle: handle, img: img }); }
        var accounts = S.readAccounts(), me = S.currentKey();
        Object.keys(accounts).forEach(function (k) {
            var a = accounts[k];
            if (k === me) return;
            if (k.toLowerCase().indexOf(lq) !== -1 || String(a.displayName || '').toLowerCase().indexOf(lq) !== -1)
                add(S.displayName(a), a.username, String(a.selectedCharacter || a.character).toLowerCase() === 'female' ? 'female-avatar.png' : 'male-avatar.png');
        });
        add(q, q, 'male-avatar.png'); add(q + '3', q + '3', 'male-avatar.png'); add(q + '2', q + '2', 'female-avatar.png');
        return out;
    }
    function render(q) {
        var list = matches(q);
        var h = '<div class="flex flex-col" data-testid="people-search-results"><h2 class="text-title-large content-emphasis bg-surface-100 send-robux-section-heading" style="position:sticky;top:0;z-index:1">People (' + list.length + ')</h2><div role="listbox" aria-label="People (' + list.length + ')">';
        list.forEach(function (u) {
            h += '<div class="flex flex-row items-center gap-medium padding-x-none send-robux-user-row width-full cursor-pointer shrink-0 radius-medium bg-none hover:bg-shift-200" role="option" tabindex="0" aria-selected="false" aria-label="' + S.esc(u.display) + ' @' + S.esc(u.handle) + '" data-handle="' + S.esc(u.handle) + '">' +
                '<span data-testid="avatar-root" class="foundation-web-avatar relative inline-flex items-center justify-center shrink-0 select-none radius-circle size-1200 bg-shift-200"><span data-testid="avatar-content" class="relative radius-circle flex items-center justify-center" style="width:48px;height:48px;overflow:hidden"><img src="' + u.img + '" alt="' + S.esc(u.display) + '" data-testid="avatar-image" style="width:100%;height:100%;object-fit:cover"></span></span>' +
                '<div class="flex flex-col min-width-0 width-full padding-y-xsmall" data-testid="user-row-text"><span class="inline-flex items-center gap-xsmall content-emphasis min-width-0 width-full clip" data-testid="user-row-name"><span class="min-width-0 text-title-medium text-truncate-end text-no-wrap">' + S.esc(u.display) + '</span></span><span class="text-body-medium content-default text-truncate-end text-no-wrap width-full">@' + S.esc(u.handle) + '</span></div></div>';
        });
        results.innerHTML = h + '</div></div>';
    }
    input.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        var q = input.value.trim();
        if (q) render(q); else results.innerHTML = '';
    });
    results.addEventListener('click', function (e) { if (e.target.closest('[role="option"]')) S.toast('Coming soon'); });
}
</script>
</body>
</html>
