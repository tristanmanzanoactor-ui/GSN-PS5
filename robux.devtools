<style id="rbxtest-profileview-styles">
html.rbx-auth-pending body { visibility: hidden; }
.profile-avatar { width: 100%; height: 100%; object-fit: cover; display: block; }
[data-rbx-avatar] { display: block !important; position: relative !important; overflow: hidden !important; border-radius: inherit; background-image: none !important; }
[data-rbx-avatar]::before, [data-rbx-avatar]::after { display: none !important; content: none !important; }
[data-rbx-avatar] > img.profile-avatar { display: block !important; visibility: visible !important; opacity: 1 !important; width: 100% !important; height: 100% !important; max-width: none !important; object-fit: cover !important; position: relative; z-index: 1; }

[hidden] { display: none !important; }
/* Profile header is a normal (non-clickable) block; only its real links/buttons are interactive */
#profile-area a, #profile-area button.more-btn, #profile-area .buttons-show-on-desktop button, #profile-area .buttons-show-on-mobile button { cursor: pointer; }
.profile-header-main { flex: 1 1 auto; color: inherit; font: inherit; text-align: left; }
/* About / Creations / Currently Wearing are always visible, stacked under the header */
#profile-details { display: block; }
#profile-details .profile-section { padding-top: 24px; }
#profile-details .profile-section-title { margin: 0 0 12px; }
#profile-details .profile-about-text { margin: 0; white-space: pre-wrap; font: inherit; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
/* Presence (online) icon: FigureBlox's own .icon-online styling is used; this only keeps it on top of the avatar */
.avatar-card-fullbody, .avatar-headshot-lg .avatar { position: relative; }
.avatar-card-fullbody > .avatar-status { position: absolute; right: 0; bottom: 0; z-index: 5; line-height: 0; pointer-events: none; }
/* only applied by script if FigureBlox's stylesheet did not load (icon would otherwise be invisible) */
.avatar-status.presence-fallback [data-testid="presence-icon"] { display: block; width: 18px; height: 18px; box-sizing: border-box; border-radius: 50%; background: #00b06f; border: 3px solid var(--color-surface-0, #fff); }
/* Profile details: About / Creations tabs (About is selected by default) */
#profile-details, #profile-details[hidden] { display: block !important; visibility: visible !important; }
#profile-details .profile-tabs { list-style: none; margin: 0; padding: 0; display: flex; border-bottom: 1px solid var(--color-divider, rgba(128,128,128,.4)); }
#profile-details .profile-tabs li { flex: 1 1 0; display: flex; justify-content: center; }
#profile-details .profile-tab { text-decoration: none; cursor: pointer; color: inherit; opacity: .75; }
#profile-details .profile-tab.active { opacity: 1; font-weight: 700; box-shadow: inset 0 -2px 0 currentColor; }
#profile-details .profile-tab-content[hidden] { display: none !important; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
.css-1jynqc0-carouselContainer { position: relative; }
.css-1i465w8-carousel { scroll-behavior: smooth; }
.scroll-arrow { position: absolute; top: 50%; right: 0; transform: translateY(-50%); cursor: pointer; z-index: 3; }
.scroll-arrow[hidden] { display: none !important; }
.scroll-arrow.arrow-fallback { width: 36px; height: 36px; border-radius: 50%; background: rgba(40,40,40,.85); color: #fff; display: flex; align-items: center; justify-content: center; }
.scroll-arrow.arrow-fallback .icon-chevron-heavy-right::before { content: "\203A"; font-size: 26px; line-height: 1; }
/* "more" -> About dialog */
.rbxtest-dialog-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100000; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(0,0,0,.6); }
.rbxtest-dialog { position: relative; width: 100%; max-width: 480px; max-height: 85vh; overflow: auto; border-radius: 12px; background: var(--color-surface-0, #fff); color: var(--color-content-default, inherit); }
.rbxtest-dialog-close { position: absolute; top: 8px; right: 12px; z-index: 1; background: none; border: 0; padding: 0 4px; font-size: 28px; line-height: 1; color: inherit; cursor: pointer; }
.rbxtest-dialog .edit-bio-btn { background: none; border: 0; padding: 0; margin-top: 8px; cursor: pointer; color: inherit; text-decoration: underline; }
.profile-platform-container[hidden], #edit-user-profile-web-app[hidden] { display: none !important; }
.profile-setting-row { text-align: left; }
.profile-setting-row-value { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rbxtest-dialog [data-profile-about] { white-space: pre-wrap; overflow-wrap: anywhere; }
#profile-area pre.description-content { white-space: pre-wrap; overflow-wrap: anywhere; }
.rbxtest-frame-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; z-index: 6; }
.rbxtest-frame-tile { width: 92px; padding: 10px 6px; border: 2px solid rgba(128,128,128,.4); border-radius: 12px; background: none; color: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; font: inherit; }
.rbxtest-frame-tile[aria-pressed="true"] { border-color: #335fff; }
.rbxtest-frame-thumb { width: 56px; height: 56px; border-radius: 50%; border: 2px dashed rgba(128,128,128,.6); display: flex; align-items: center; justify-content: center; font-size: 24px; opacity: .8; }
/* fallback layout for the Currently Wearing carousel (its styles are normally injected by FigureBlox's scripts) */
.css-1i465w8-carousel { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }
.css-izzd58-carouselItem, .css-6xn1qo-carouselItem { flex: 0 0 150px; width: 150px; }

</style>
<script src="shell.js" defer></script>
<script id="rbxtest-avatar-detect">
/* AVATAR DETECTION SCRIPT
   Signup saves account.selectedCharacter = "male" | "female" (see index.html).
   This script detects the logged-in account, reads that saved choice and puts the matching avatar URL
   (male -> proud-river worker, female -> green-leaf worker) into the <img> inside EVERY
   .thumbnail-2d-container.avatar-card-image on the page, now and whenever the site redraws one. */
(function () {
    var URLS = {
        male: 'https://proud-river-a3e7.tristan-manzano-actor.workers.dev/',
        female: 'https://green-leaf-a836.tristan-manzano-actor.workers.dev/'
    };
    var SELECTOR = '.thumbnail-2d-container.avatar-card-image';
    var EXTRA = 'a[href="/users/profile"] .thumbnail-2d-container, a[href^="/users/"][href$="/profile"] .thumbnail-2d-container, #header .avatar-headshot .thumbnail-2d-container, #header .avatar-headshot-xs .thumbnail-2d-container';

    function readJSON(storage, key) {
        try { return JSON.parse(storage.getItem(key)); } catch (e) { return null; }
    }
    // 1) the current logged-in account (session -> saved account)
    function detectCurrentAccount() {
        var session = readJSON(sessionStorage, 'rbxtest_session') || readJSON(localStorage, 'rbxtest_session');
        if (!session || !session.username) return null;
        var accounts = readJSON(localStorage, 'rbxtest_accounts') || {};
        return accounts[session.username] || null;
    }
    // 2) its saved selectedCharacter -> the avatar URL
    function avatarFileForAccount(account) {
        var choice = String((account && (account.selectedCharacter || account.character)) || '').toLowerCase();
        return choice === 'female' ? URLS.female : URLS.male;
    }

    function setAvatar(container, file) {
        var only = container.children.length === 1 ? container.firstElementChild : null;
        if (only && only.tagName === 'IMG' && only.getAttribute('data-avatar-file') === file ) return;   // already correct
        var img = document.createElement('img');
        img.className = 'profile-avatar';
        img.setAttribute('data-avatar-file', file);
        img.alt = 'FigureBlox avatar';
        img.src = file;
        container.setAttribute('data-rbx-avatar', 'true');
        Array.prototype.slice.call(container.classList).forEach(function (c) {
            if (/shimmer|loading|broken|placeholder/i.test(c)) container.classList.remove(c);
        });
        container.replaceChildren(img);
    }
    // 3) put the PNG into both (all) avatar locations
    function loadAccountAvatar(currentAccount) {
        currentAccount = currentAccount || detectCurrentAccount();
        if (!currentAccount) return;
        var file = avatarFileForAccount(currentAccount);
        var seen = [];
        var list = Array.prototype.slice.call(document.querySelectorAll(SELECTOR))
            .concat(Array.prototype.slice.call(document.querySelectorAll(EXTRA)));
        list.forEach(function (container) {
            if (seen.indexOf(container) !== -1) return;
            seen.push(container);
            setAvatar(container, file);
        });
    }
    window.detectCurrentAccount = detectCurrentAccount;
    window.avatarFileForAccount = avatarFileForAccount;
    window.loadAccountAvatar = loadAccountAvatar;

    // run now, when the DOM is ready, when everything has loaded, and whenever the site re-renders an avatar
    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        (window.requestAnimationFrame || setTimeout)(function () { queued = false; loadAccountAvatar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule); else schedule();
    window.addEventListener('load', schedule);
    new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>


<style id="rbxtest-robux-styles">
.buy-robux-page{position:relative;max-width:1000px;margin:0 auto;padding:0 0 48px}
.buy-robux-content{display:flex;flex-direction:column;gap:32px}
.buy-robux-section-header{font-weight:700}
.robux-section{padding:24px;display:flex;flex-direction:column;gap:24px}
.robux-section>div{width:100%}
.price-tag{font-weight:700}
.rbxtest-robux-top{display:flex;justify-content:flex-end;padding:16px 0}
.rbxtest-robux-top .bal{display:flex;align-items:center;gap:16px}
.rbxtest-robux-top .bal .num{font-size:28px;font-weight:800}
.carousel-track-fb{display:flex;gap:16px;overflow-x:auto;scrollbar-width:none}
.faq-panel{padding:8px 0 16px;line-height:1.5}
.faq-panel[hidden]{display:none!important}
.robux-amount-strike-through{position:absolute;left:0;right:0;top:50%;height:1px;background:currentColor}
/* Send Robux sheet */
#rbxtest-send-overlay{position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:16px}
#rbxtest-send-overlay[hidden]{display:none!important}
#rbxtest-send-overlay .fui-base-sheet-content{width:100%;max-width:480px;height:min(640px,calc(100vh - 32px));border-radius:16px}
.send-robux-section-heading{padding:12px 0;margin:0}
.send-robux-user-row{padding:8px 0;min-height:56px}
</style>
