</main>
<footer class="container-footer" id="footer-container"><div class="footer"><ul class="row footer-links flex flex-wrap justify-center padding-bottom-xxsmall"><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">About Us</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Jobs</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Newsroom</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Parents</a></li><li class="footer-link"><a href="#" class="text-footer-nav giftcards" target="_blank" rel="noreferrer">Buy Gift Cards</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Help</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Terms</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Accessibility</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Privacy</a></li><li class="footer-link"><a href="#" class="text-footer-nav" target="_blank" rel="noreferrer">Sitemap</a></li></ul><div class="row copyright-container flex items-center justify-between padding-top-xlarge gutter-x-small"><div class="col-sm-6 col-md-9"><p class="text-footer footer-note">©2026 FigureBlox Corporation. FigureBlox, the FigureBlox logo and Powering Imagination are among our registered and unregistered trademarks in the U.S. and other countries.</p></div></div></div></footer>
