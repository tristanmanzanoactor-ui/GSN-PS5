<script id="rbxtest-profile-route">
/* Routes every profile link (/users/profile or /users/<id>/profile, relative or on any host,
   including the workers.dev address the page is served from) to the local profileview.devtools page. */
(function () {
    var TARGET = 'profileview.devtools';
    function isProfile(a) {
        var h = a.getAttribute && a.getAttribute('href');
        if (!h || h === TARGET) return false;
        var path;
        try { path = new URL(h, window.location.href).pathname; } catch (e) { return false; }
        return /^\/users\/(\d+\/)?profile\/?$/.test(path);
    }
    function patch(root) {
        (root.querySelectorAll ? root.querySelectorAll('a[href*="/users/"]') : []).forEach(function (a) {
            if (isProfile(a)) a.setAttribute('href', TARGET);
        });
    }
    document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a || !isProfile(a)) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.ctrlKey || e.metaKey || a.target === '_blank') window.open(TARGET, '_blank');
        else window.location.href = TARGET;
    }, true);
    patch(document);
    new MutationObserver(function () { patch(document); })
        .observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script id="rbxtest-build">
/* Build stamp: open any page with ?build on the end (e.g. profileview.devtools?build) to see which version is being served. */
(function () {
    var BUILD = 'r9-2026-10-04';
    try { console.log('FigureBlox build', BUILD); } catch (e) {}
    if (!/[?&]build\b/.test(location.search)) return;
    var b = document.createElement('div');
    b.textContent = 'build ' + BUILD;
    b.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:2147483647;background:#111;color:#0f0;font:12px monospace;padding:4px 8px;border-radius:4px;';
    document.body.appendChild(b);
})();
</script>
<script id="rbxtest-plus">
document.documentElement.classList.add('rbx-auth-pending');
document.addEventListener('DOMContentLoaded', function () { rbxShell.requireLogin(init); });
function init() {
    var I = function (c, s, x) { return '<span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon ' + c + ' size-[var(--icon-size-' + s + ')]"' + (x ? ' style="' + x + '"' : '') + '></span>'; };
    var BEN = [['icon-regular-tag','Discounts on items, avatars, and more','10% off for the first 60 days, then 20% off'],['icon-regular-image-person','Avatar backgrounds','Choose or create a background for your avatar'],['icon-regular-paint-brush','App themes','Change the color of your platform background'],['icon-regular-circle-dashed-person','Profile frames','Customize your avatar with exclusive frames'],['icon-regular-controller','Free private servers','Choose who you play with'],['icon-regular-robux','Send Robux for free','May need parental approval'],['icon-regular-hand-two-arrows-horizontal','Trade and resell limited items','Build your collection of rare avatars'],['icon-regular-arrow-up-from-landscape-rectangle','Publish games and avatar items','Reach millions of players on Marketplace']];
    var BUN = [['Plus 500','$9.98','$8.99','+500 Robux every month'],['Plus 1000','$14.98','$12.99','+1,000 Robux every month'],['Plus 2000','$24.98','$21.99','+2,000 Robux every month']];
    var h = '<style>.plus-page{max-width:792px;margin:48px auto 0;padding:0 24px 48px;display:flex;flex-direction:column;gap:48px}.plus-hero{text-align:center;display:flex;flex-direction:column;align-items:center;gap:24px}.plus-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}@media(max-width:700px){.plus-grid{grid-template-columns:1fr}}.plus-grid button{width:100%;display:flex;align-items:center;gap:16px;padding:16px;border-radius:12px;text-align:left;cursor:pointer;font:inherit}.plus-track{display:flex;gap:16px;overflow-x:auto;scrollbar-width:none}.plus-card{flex:0 0 240px;padding:16px;border-radius:12px;display:flex;flex-direction:column;gap:12px}.plus-card ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}.plus-card li{display:flex;align-items:center;gap:12px}</style>';
    h += '<div class="plus-page content-emphasis"><div class="plus-hero"><div><div style="display:flex;align-items:center;justify-content:center;gap:4px">' + I('icon-regular-roblox-plus','large','position:relative;top:-1px') + '<span class="text-label-large content-emphasis">FigureBlox Plus</span></div>';
    h += '<h1 class="font-builder-extended text-display-small content-emphasis" style="font-size:40px">Our best deal. Unlock 20% off.</h1></div>';
    h += '<span class="text-heading-small content-emphasis" data-testid="already-subscribed">You are already subscribed.</span></div>';
    h += '<div style="display:flex;flex-direction:column;gap:16px"><span class="text-heading-small">Why join Plus?</span><ul class="plus-grid">';
    BEN.forEach(function (b) { h += '<li><button type="button" aria-label="' + b[1] + '" class="bg-surface-100 stroke-standard stroke-default content-emphasis">' + I(b[0],'large') + '<div style="display:flex;flex-direction:column;gap:4px"><div class="text-title-medium content-emphasis">' + b[1] + '</div><div class="text-body-medium content-default">' + b[2] + '</div></div></button></li>'; });
    h += '</ul></div><div style="display:flex;flex-direction:column;gap:16px"><div><span class="text-heading-small">Get Robux every month</span><br><span class="text-body-medium content-default">Add monthly Robux with a Plus bundle</span></div><div class="plus-track">';
    BUN.forEach(function (c) { h += '<div class="plus-card bg-surface-100"><div style="display:flex;justify-content:space-between;gap:16px"><span class="text-label-large content-emphasis">' + c[0] + '</span><span><span class="text-title-medium" style="text-decoration:line-through;opacity:.6">' + c[1] + '</span> <span class="text-title-medium content-emphasis">' + c[2] + '</span></span></div><ul><li>' + I('icon-regular-roblox-plus','medium') + '<span class="text-body-medium content-default">Everything in Plus</span></li><li>' + I('icon-regular-robux','medium') + '<span class="text-body-medium content-default">' + c[3] + '</span></li><li>' + I('icon-regular-pig','medium') + '<span class="text-body-medium content-default">' + c[1] + ' total value</span></li></ul><button type="button" data-soon class="foundation-web-button relative clip cursor-pointer flex items-center justify-center stroke-none select-none radius-medium text-label-medium height-1000 padding-x-medium bg-action-standard content-action-standard width-full">' + c[2] + '/month</button></div>'; });
    h += '</div></div></div>';
    document.getElementById('plus-root').innerHTML = h;
    document.getElementById('plus-root').addEventListener('click', function (e) { if (e.target.closest('[data-soon]')) rbxShell.toast('Coming soon'); });
}
</script></body>
</html>
