<style id="rbxtest-profileview-styles">
html.rbx-auth-pending body { visibility: hidden; }
.profile-avatar { width: 100%; height: 100%; object-fit: cover; display: block; }
[data-rbx-avatar] { display: block !important; position: relative !important; overflow: hidden !important; border-radius: inherit; background-image: none !important; }
[data-rbx-avatar]::before, [data-rbx-avatar]::after { display: none !important; content: none !important; }
[data-rbx-avatar] > img.profile-avatar { display: block !important; visibility: visible !important; opacity: 1 !important; width: 100% !important; height: 100% !important; max-width: none !important; object-fit: cover !important; position: relative; z-index: 1; }

[hidden] { display: none !important; }
/* Profile header is a normal (non-clickable) block; only its real links/buttons are interactive */
#profile-area a, #profile-area button.more-btn, #profile-area .buttons-show-on-desktop button, #profile-area .buttons-show-on-mobile button { cursor: pointer; }
.profile-header-main { flex: 1 1 auto; color: inherit; font: inherit; text-align: left; }
/* About / Creations / Currently Wearing are always visible, stacked under the header */
#profile-details { display: block; }
#profile-details .profile-section { padding-top: 24px; }
#profile-details .profile-section-title { margin: 0 0 12px; }
#profile-details .profile-about-text { margin: 0; white-space: pre-wrap; font: inherit; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
/* Presence (online) icon: FigureBlox's own .icon-online styling is used; this only keeps it on top of the avatar */
.avatar-card-fullbody, .avatar-headshot-lg .avatar { position: relative; }
.avatar-card-fullbody > .avatar-status { position: absolute; right: 0; bottom: 0; z-index: 5; line-height: 0; pointer-events: none; }
/* only applied by script if FigureBlox's stylesheet did not load (icon would otherwise be invisible) */
.avatar-status.presence-fallback [data-testid="presence-icon"] { display: block; width: 18px; height: 18px; box-sizing: border-box; border-radius: 50%; background: #00b06f; border: 3px solid var(--color-surface-0, #fff); }
/* Profile details: About / Creations tabs (About is selected by default) */
#profile-details, #profile-details[hidden] { display: block !important; visibility: visible !important; }
#profile-details .profile-tabs { list-style: none; margin: 0; padding: 0; display: flex; border-bottom: 1px solid var(--color-divider, rgba(128,128,128,.4)); }
#profile-details .profile-tabs li { flex: 1 1 0; display: flex; justify-content: center; }
#profile-details .profile-tab { text-decoration: none; cursor: pointer; color: inherit; opacity: .75; }
#profile-details .profile-tab.active { opacity: 1; font-weight: 700; box-shadow: inset 0 -2px 0 currentColor; }
#profile-details .profile-tab-content[hidden] { display: none !important; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
.css-1jynqc0-carouselContainer { position: relative; }
.css-1i465w8-carousel { scroll-behavior: smooth; }
.scroll-arrow { position: absolute; top: 50%; right: 0; transform: translateY(-50%); cursor: pointer; z-index: 3; }
.scroll-arrow[hidden] { display: none !important; }
.scroll-arrow.arrow-fallback { width: 36px; height: 36px; border-radius: 50%; background: rgba(40,40,40,.85); color: #fff; display: flex; align-items: center; justify-content: center; }
.scroll-arrow.arrow-fallback .icon-chevron-heavy-right::before { content: "\203A"; font-size: 26px; line-height: 1; }
/* "more" -> About dialog */
.rbxtest-dialog-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100000; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(0,0,0,.6); }
.rbxtest-dialog { position: relative; width: 100%; max-width: 480px; max-height: 85vh; overflow: auto; border-radius: 12px; background: var(--color-surface-0, #fff); color: var(--color-content-default, inherit); }
.rbxtest-dialog-close { position: absolute; top: 8px; right: 12px; z-index: 1; background: none; border: 0; padding: 0 4px; font-size: 28px; line-height: 1; color: inherit; cursor: pointer; }
.rbxtest-dialog .edit-bio-btn { background: none; border: 0; padding: 0; margin-top: 8px; cursor: pointer; color: inherit; text-decoration: underline; }
.profile-platform-container[hidden], #edit-user-profile-web-app[hidden] { display: none !important; }
.profile-setting-row { text-align: left; }
.profile-setting-row-value { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rbxtest-dialog [data-profile-about] { white-space: pre-wrap; overflow-wrap: anywhere; }
#profile-area pre.description-content { white-space: pre-wrap; overflow-wrap: anywhere; }
.rbxtest-frame-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; z-index: 6; }
.rbxtest-frame-tile { width: 92px; padding: 10px 6px; border: 2px solid rgba(128,128,128,.4); border-radius: 12px; background: none; color: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; font: inherit; }
.rbxtest-frame-tile[aria-pressed="true"] { border-color: #335fff; }
.rbxtest-frame-thumb { width: 56px; height: 56px; border-radius: 50%; border: 2px dashed rgba(128,128,128,.6); display: flex; align-items: center; justify-content: center; font-size: 24px; opacity: .8; }
/* fallback layout for the Currently Wearing carousel (its styles are normally injected by FigureBlox's scripts) */
.css-1i465w8-carousel { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }
.css-izzd58-carouselItem, .css-6xn1qo-carouselItem { flex: 0 0 150px; width: 150px; }

</style>
<script src="shell.js" defer></script>
<script id="rbxtest-avatar-detect">
/* AVATAR DETECTION SCRIPT
   Signup saves account.selectedCharacter = "male" | "female" (see index.html).
   This script detects the logged-in account, reads that saved choice and puts the matching avatar URL
   (male -> proud-river worker, female -> green-leaf worker) into the <img> inside EVERY
   .thumbnail-2d-container.avatar-card-image on the page, now and whenever the site redraws one. */
(function () {
    var URLS = {
        male: 'https://proud-river-a3e7.tristan-manzano-actor.workers.dev/',
        female: 'https://green-leaf-a836.tristan-manzano-actor.workers.dev/'
    };
    var SELECTOR = '.thumbnail-2d-container.avatar-card-image';
    var EXTRA = 'a[href="/users/profile"] .thumbnail-2d-container, a[href^="/users/"][href$="/profile"] .thumbnail-2d-container, #header .avatar-headshot .thumbnail-2d-container, #header .avatar-headshot-xs .thumbnail-2d-container';

    function readJSON(storage, key) {
        try { return JSON.parse(storage.getItem(key)); } catch (e) { return null; }
    }
    // 1) the current logged-in account (session -> saved account)
    function detectCurrentAccount() {
        var session = readJSON(sessionStorage, 'rbxtest_session') || readJSON(localStorage, 'rbxtest_session');
        if (!session || !session.username) return null;
        var accounts = readJSON(localStorage, 'rbxtest_accounts') || {};
        return accounts[session.username] || null;
    }
    // 2) its saved selectedCharacter -> the avatar URL
    function avatarFileForAccount(account) {
        var choice = String((account && (account.selectedCharacter || account.character)) || '').toLowerCase();
        return choice === 'female' ? URLS.female : URLS.male;
    }

    function setAvatar(container, file) {
        var only = container.children.length === 1 ? container.firstElementChild : null;
        if (only && only.tagName === 'IMG' && only.getAttribute('data-avatar-file') === file ) return;   // already correct
        var img = document.createElement('img');
        img.className = 'profile-avatar';
        img.setAttribute('data-avatar-file', file);
        img.alt = 'FigureBlox avatar';
        img.src = file;
        container.setAttribute('data-rbx-avatar', 'true');
        Array.prototype.slice.call(container.classList).forEach(function (c) {
            if (/shimmer|loading|broken|placeholder/i.test(c)) container.classList.remove(c);
        });
        container.replaceChildren(img);
    }
    // 3) put the PNG into both (all) avatar locations
    function loadAccountAvatar(currentAccount) {
        currentAccount = currentAccount || detectCurrentAccount();
        if (!currentAccount) return;
        var file = avatarFileForAccount(currentAccount);
        var seen = [];
        var list = Array.prototype.slice.call(document.querySelectorAll(SELECTOR))
            .concat(Array.prototype.slice.call(document.querySelectorAll(EXTRA)));
        var viewed = window.__rbxViewAccount;   // set when another player's profile is open
        list.forEach(function (container) {
            if (seen.indexOf(container) !== -1) return;
            seen.push(container);
            setAvatar(container, viewed && container.closest('#container-main') ? avatarFileForAccount(viewed) : file);
        });
    }
    window.detectCurrentAccount = detectCurrentAccount;
    window.avatarFileForAccount = avatarFileForAccount;
    window.loadAccountAvatar = loadAccountAvatar;

    // run now, when the DOM is ready, when everything has loaded, and whenever the site re-renders an avatar
    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        (window.requestAnimationFrame || setTimeout)(function () { queued = false; loadAccountAvatar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule); else schedule();
    window.addEventListener('load', schedule);
    new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script id="rbxtest-profileview">
document.documentElement.classList.add('rbx-auth-pending');   // hidden until the saved session is verified
(function () {
    var ACCOUNTS_KEY = 'rbxtest_accounts', SESSION_KEY = 'rbxtest_session';
    function readJSON(storage, key, fallback) {
        try { var v = JSON.parse(storage.getItem(key)); return v === null || v === undefined ? fallback : v; } catch (e) { return fallback; }
    }
    function readSession() {
        var stores = [sessionStorage, localStorage];
        for (var i = 0; i < stores.length; i++) {
            var s = readJSON(stores[i], SESSION_KEY, null);
            if (s && typeof s === 'object' && s.username && s.token) return s;
        }
        return null;
    }
    function sha256Hex(text) {
        if (window.crypto && crypto.subtle) {
            return crypto.subtle.digest('SHA-256', new TextEncoder().encode(text)).then(function (buf) {
                return Array.prototype.map.call(new Uint8Array(buf), function (b) { return ('0' + b.toString(16)).slice(-2); }).join('');
            });
        }
        var h = 5381;
        for (var i = 0; i < text.length; i++) h = ((h << 5) + h + text.charCodeAt(i)) >>> 0;
        return Promise.resolve('weak-' + h.toString(16));
    }
    function tokenHash(token) { return sha256Hex('session:' + token); }

    // Online (presence) icon: shown only while the user is on the site with a valid login session
    function updatePresence() {
        if (viewed) {   // another player's profile: their real online / offline state
            var on = !!(window.rbxShell && rbxShell.isOnline(viewed.username));
            document.querySelectorAll('#profile-area .avatar-status').forEach(function (el) {
                el.hidden = !on;
                if (!on) return;
                var icon = el.querySelector('[data-testid="presence-icon"]');
                el.classList.remove('presence-fallback');
                if (icon && icon.getBoundingClientRect().width < 4) el.classList.add('presence-fallback');
            });
            return paintStatus(on);
        }
        var session = readSession();
        var acc = session && readJSON(localStorage, ACCOUNTS_KEY, {})[session.username];
        var go = function (on) {
            paintStatus(on);
            document.querySelectorAll('#profile-area .avatar-status').forEach(function (el) {
                el.hidden = !on;
                if (!on) return;
                var icon = el.querySelector('[data-testid="presence-icon"]');
                el.classList.remove('presence-fallback');
                if (icon && icon.getBoundingClientRect().width < 4) el.classList.add('presence-fallback');
            });
        };
        if (!acc) return go(false);
        tokenHash(session.token).then(function (hash) {
            go((acc.tokenHashes || []).indexOf(hash) !== -1);
        });
    }
    window.addEventListener('storage', updatePresence);          // logged out / in from another tab
    window.addEventListener('pageshow', updatePresence);
    window.addEventListener('load', updatePresence);

    // About / Creations tabs: About is shown on load; clicking a tab swaps the panes
    function setupTabs() {
        var tabs = document.querySelectorAll('#profile-details .profile-tab');
        var panes = document.querySelectorAll('#profile-details .profile-tab-content');
        function show(name) {
            tabs.forEach(function (t) { t.classList.toggle('active', t.id === 'tab-' + name); });
            panes.forEach(function (p) {
                var on = p.getAttribute('data-tab-pane') === name;
                p.hidden = !on; p.classList.toggle('hidden', !on);
            });
        }
        tabs.forEach(function (t) {
            t.addEventListener('click', function (e) { e.preventDefault(); show(t.id.replace('tab-', '')); });
        });
        show(location.hash === '#creations' ? 'creations' : 'about');
    }
    // "next" arrow on the Currently Wearing row
    function setupCarouselArrow() {
        var row = document.querySelector('#profile-details .css-1i465w8-carousel');
        var arrow = document.querySelector('#profile-details .scroll-arrow.next');
        if (!row || !arrow) return;
        function sync() {
            arrow.hidden = row.scrollWidth - row.clientWidth - row.scrollLeft <= 4;
            var icon = arrow.querySelector('[data-testid="carousel-scroll-arrow-icon"]');
            // FigureBlox's stylesheet normally draws this arrow; if it did not load, draw a simple one
            if (!arrow.hidden && icon && !arrow.classList.contains('arrow-fallback') && arrow.getBoundingClientRect().width < 4) arrow.classList.add('arrow-fallback');
        }
        function next() { row.scrollBy({ left: Math.max(300, row.clientWidth * 0.8), behavior: 'smooth' }); }
        arrow.addEventListener('click', next);
        arrow.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); next(); } });
        row.addEventListener('scroll', sync);
        window.addEventListener('resize', sync);
        window.addEventListener('load', sync);
        sync();
    }

    // ---------- Account data (saved in the same localStorage account record created at signup) ----------
    var userKey = null, current = null, viewed = null;   // viewed = another player's account when ?u=name is in the URL
    function subject() { return viewed || current; }
    var FEMALE_WEARING = "<div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/86499666/Woman-Torso\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-8aed62b01454138862679e7d10fe3214/150/150/Torso/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Woman Torso\">Woman Torso<\/div><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/86499698/Woman-Right-Arm\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-0f055a22b9b4f3f56916062f3c138e3a/150/150/RightArm/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Woman Right Arm\">Woman Right Arm<\/div><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/86499716/Woman-Left-Arm\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-9ea9ab3dff002c34e91cdc3689d8f691/150/150/LeftArm/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Woman Left Arm\">Woman Left Arm<\/div><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/86499753/Woman-Left-Leg\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-af00e83cd9d64118232be884fd8cfe50/150/150/LeftLeg/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Woman Left Leg\">Woman Left Leg<\/div><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/86499793/Woman-Right-Leg\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-2903f8a38eb9ab8b5ac832ad698257d2/150/150/RightLeg/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Woman Right Leg\">Woman Right Leg<\/div><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/bundles/946/Stevie-Standard\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/30DAY-DynamicHeadCostume-DEDA5A3711A759312A2AE54E64C90182-Png/150/150/DynamicHeadCostume/Webp/noFilter\" alt=\"\"><\/span><\/div><span class=\"restriction-icon \"><\/span><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Stevie Standard\">Stevie Standard<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Free<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/144076436/Grey-Striped-Shirt-with-Denim-Jacket\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-89a46c4095228f3fa4bc91dbe37867fd/150/150/Shirt/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Grey Striped Shirt with Denim Jacket\">Grey Striped Shirt with Denim Jacket<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Free<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/3576686446/Hello\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-a09e4983bbb794987fe4d17d99229775/150/150/EmoteAnimation/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Hello\">Hello<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Free<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/3360686498/Stadium\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-b8b896eea07b9ff60e33bd4af613c771/150/150/EmoteAnimation/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Stadium\">Stadium<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Free<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/3576823880/Point2\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-c08b49e1ae6e6709459a9edd567f6bb1/150/150/EmoteAnimation/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Point2\">Point2<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Free<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/3576968026/Shrug\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-050161df3093d40334da37d0af822ad5/150/150/EmoteAnimation/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Shrug\">Shrug<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Free<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/62724852/Chestnut-Bun\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-96146b6d6d0937c03156c6e2fa16866a/150/150/HairAccessory/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Chestnut Bun\">Chestnut Bun<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Off Sale<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div><div id=\"collection-carousel-item\" class=\"css-6xn1qo-carouselItem\"><div><div class=\"item-card  profile-item-card\"><div class=\"item-card-container\"><a href=\"https://www.roblox.com/catalog/144076512/Pink-Jeans\" target=\"_self\" class=\"item-card-link\"><div class=\"item-card-link\"><div class=\"item-card-thumb-container\"><div class=\"item-card-thumb-container-inner\"><span class=\"thumbnail-2d-container\"><img class=\"\" src=\"https://tr.rbxcdn.com/180DAY-154af358cb7b871258e48415de1c8927/150/150/Pants/Webp/noFilter\" alt=\"\"><\/span><\/div><\/div><\/div><div class=\"item-card-caption\"><div class=\"item-card-name-link\"><div class=\"item-card-name\" title=\"Pink Jeans\">Pink Jeans<\/div><\/div><div class=\"text-overflow item-card-price font-header-2 text-subheader\"><span class=\"text text-label text-robux-tile\">Off Sale<\/span><\/div><\/div><\/a><\/div><\/div><\/div><\/div>";
    function isFemale(acc) { return String((acc && (acc.selectedCharacter || acc.character)) || '').toLowerCase() === 'female'; }
    function applyWearing() {
        // the Currently Wearing row follows the profile owner's character (female -> Woman items)
        if (!isFemale(subject())) return;
        var row = document.querySelector('#profile-details .css-1i465w8-carousel');
        if (row) row.innerHTML = FEMALE_WEARING;
    }
    var PLUS_ICON = '<span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-roblox-plus size-[var(--icon-size-large)] relative rbxtest-plus" style="top:-1px;margin-left:4px;flex:none;cursor:pointer;"></span>';
    // Online / Offline text under the @handle; the verified check on the FigureBlox account shows only while it is online
    function paintStatus(on) {
        var acc = subject();
        if (!acc) return;
        var handle = document.querySelector('#profile-area [data-rbx-handle], #profile-area [data-view-handle]');
        if (handle) {
            var host = handle.parentElement, t = host.querySelector('.rbxtest-presence-text');
            if (!t) { t = document.createElement('div'); t.className = 'rbxtest-presence-text text-body-small'; t.style.cssText = 'display:flex;align-items:center;margin-top:2px;opacity:.85;'; host.appendChild(t); }
            var html = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:' + (on ? '#00b06f' : '#8a8d94') + ';"></span>' + (on ? 'Online' : 'Offline');
            if (t.innerHTML !== html) t.innerHTML = html;
        }
        if (!viewed) return;   // on your own profile shell.js already places the badge and Plus icon
        var nameEl = document.querySelector('#profile-area [data-view-name]');
        if (!nameEl) return;
        var badge = nameEl.parentElement.querySelector('.rbxtest-verified');
        var want = !!(window.rbxShell && rbxShell.isVerified(viewed) && on);
        if (want && !badge) nameEl.insertAdjacentHTML('afterend', rbxShell.verifiedHTML);
        if (!want && badge) badge.remove();
        if (!nameEl.parentElement.querySelector('.rbxtest-plus')) nameEl.parentElement.insertAdjacentHTML('beforeend', PLUS_ICON);
    }
    function prepareViewMode() {
        // detach this page's name / @handle from the logged-in account (shell.js would overwrite them) and hide edit controls
        document.querySelectorAll('#container-main [data-rbx-username]').forEach(function (n) { n.removeAttribute('data-rbx-username'); n.setAttribute('data-view-name', ''); });
        document.querySelectorAll('#container-main [data-rbx-handle]').forEach(function (n) { n.removeAttribute('data-rbx-handle'); n.setAttribute('data-view-handle', ''); });
        document.querySelectorAll('#user-profile-header-EditAvatar, #user-profile-header-EditProfile, #user-profile-header-EditAvatar-mobile, #user-profile-header-EditProfile-mobile, #about-dialog .edit-bio-btn').forEach(function (n) { n.hidden = true; n.style.display = 'none'; });
        window.__rbxViewAccount = viewed;
    }

    function saveAccount(patch) {
        var all = readJSON(localStorage, ACCOUNTS_KEY, {});
        if (!all[userKey]) return;
        Object.keys(patch).forEach(function (k) { all[userKey][k] = patch[k]; });
        localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(all));
        current = all[userKey];
    }
    function displayName(acc) { return (acc && acc.displayName) || (acc && acc.username) || ''; }

    // Join date = the moment the account was created at signup (account.created, an ISO timestamp)
    function formatJoinDate(account) {
        var d = account && account.created ? new Date(account.created) : new Date();
        if (isNaN(d.getTime())) d = new Date();
        return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
    }

    // Frames: set `png` to the image path once the PNGs exist (e.g. 'frames/gold.png').
    // While png is null the Change button shows "Coming soon" and nothing is saved.
    var FRAMES = [
        { id: 'none', label: 'None', png: null },
        { id: 'frame-1', label: 'Frame 1', png: null },
        { id: 'frame-2', label: 'Frame 2', png: null },
        { id: 'frame-3', label: 'Frame 3', png: null },
        { id: 'frame-4', label: 'Frame 4', png: null }
    ];
    function frameById(id) { return FRAMES.filter(function (f) { return f.id === id; })[0] || FRAMES[0]; }

    function renderProfile() {
        var acc = subject();
        var name = displayName(acc);
        document.title = name + ' - FigureBlox';
        var meta = document.querySelector('meta[name="user-data"]');
        if (meta && !viewed) { meta.setAttribute('data-name', acc.username); meta.setAttribute('data-displayName', name); }
        document.querySelectorAll(viewed ? '[data-view-name]' : '[data-rbx-username]').forEach(function (el) { el.textContent = name; });
        document.querySelectorAll(viewed ? '[data-view-handle]' : '[data-rbx-handle]').forEach(function (el) { el.textContent = '@' + acc.username; });
        var bio = (acc.bio || '').trim() || 'No bio yet';   // shown on the profile for anyone who opens it
        document.querySelectorAll('[data-profile-about], #profile-area .description-content').forEach(function (el) { el.textContent = bio; });
        document.querySelectorAll('[data-rbx-joindate]').forEach(function (el) { el.textContent = formatJoinDate(acc); });
        var fc = ((acc.friends || []).length);
        document.querySelectorAll('#profile-area span').forEach(function (n) {
            if (!n.children.length && /^\d+ Friends?$/.test(n.textContent.trim())) n.textContent = fc + (fc === 1 ? ' Friend' : ' Friends');
        });
        applyFrame();
    }
    function applyFrame() {
        document.querySelectorAll('.rbxtest-frame-overlay').forEach(function (n) { n.remove(); });
        var f = frameById(subject() && subject().frame);
        if (!f.png) return;
        document.querySelectorAll('#profile-area .avatar-card-fullbody, #edit-user-profile-web-app .width-2400.height-2400').forEach(function (host) {
            var img = document.createElement('img');
            img.className = 'rbxtest-frame-overlay'; img.src = f.png; img.alt = '';
            host.appendChild(img);
        });
    }

    // ---------- Small modal toolkit (reuses the About dialog's look) ----------
    var BLUE = '#335fff', GREY = '#8a8d94';
    function el(tag, cls, text) {
        var n = document.createElement(tag);
        if (cls) n.className = cls;
        if (text !== undefined) n.textContent = text;
        return n;
    }
    function actionButton(label) {
        var b = el('button', '', label);
        b.type = 'button';
        b.style.cssText = 'min-width:104px;height:40px;padding:0 16px;border:0;border-radius:8px;color:#fff;font:inherit;font-weight:600;';
        setEnabled(b, true);
        return b;
    }
    function setEnabled(b, on) {
        b.disabled = !on;
        b.style.background = on ? BLUE : GREY;
        b.style.cursor = on ? 'pointer' : 'not-allowed';
    }
    function openModal(title) {
        var opener = document.activeElement;
        var overlay = el('div', 'rbxtest-dialog-overlay');
        overlay.style.zIndex = '100001';
        var box = el('div', 'rbxtest-dialog');
        box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true'); box.setAttribute('aria-label', title);
        var x = el('button', 'rbxtest-dialog-close'); x.type = 'button'; x.setAttribute('aria-label', 'Close'); x.innerHTML = '&times;';
        var body = el('div', 'flex flex-col');
        body.style.cssText = 'display:flex;flex-direction:column;gap:16px;padding:24px;';
        body.appendChild(el('h2', 'text-heading-small', title));
        box.appendChild(x); box.appendChild(body); overlay.appendChild(box);
        document.body.appendChild(overlay);
        document.body.style.overflow = 'hidden';
        function close() {
            document.removeEventListener('keydown', onKey, true);
            overlay.remove();
            if (document.getElementById('about-dialog').hidden) document.body.style.overflow = '';
            if (opener && opener.focus && document.contains(opener)) opener.focus();
        }
        function onKey(e) { if (e.key === 'Escape') { e.stopPropagation(); close(); } }
        document.addEventListener('keydown', onKey, true);
        x.addEventListener('click', close);
        overlay.addEventListener('mousedown', function (e) { if (e.target === overlay) close(); });
        return { body: body, close: close };
    }

    // Change Bio: whatever is typed and saved shows on the profile page
    function openBioModal() {
        var m = openModal('Change Bio');
        m.body.appendChild(el('p', 'text-body-medium', 'Let others know more about you. Keep yourself safe, do not share personal details.'));
        var ta = el('textarea', 'foundation-web-text-area foundation-web-input outline-none radius-medium');
        ta.rows = 6; ta.maxLength = 1000; ta.placeholder = 'Enter your description...'; ta.value = (current.bio || '');
        ta.style.cssText = 'width:100%;box-sizing:border-box;padding:8px 12px;border:1px solid rgba(128,128,128,.5);border-radius:8px;background:transparent;color:inherit;font:inherit;resize:vertical;';
        var count = el('span', 'text-caption-medium', ta.value.length + '/1000');
        var countRow = el('div'); countRow.style.cssText = 'display:flex;justify-content:flex-end;margin-top:-8px;';
        countRow.appendChild(count);
        var save = actionButton('Save');
        ta.addEventListener('input', function () { count.textContent = ta.value.length + '/1000'; });
        save.addEventListener('click', function () {
            saveAccount({ bio: ta.value.trim() });
            renderProfile();
            m.close();
        });
        m.body.appendChild(ta); m.body.appendChild(countRow); m.body.appendChild(save);
        ta.focus();
    }

    // Change Name (display name): one change every 7 days
    var NAME_COOLDOWN = 7 * 24 * 60 * 60 * 1000;
    function nameCooldownDays() {
        var at = current && current.displayNameChangedAt;
        if (!at) return 0;
        var left = at + NAME_COOLDOWN - Date.now();
        return left > 0 ? Math.ceil(left / (24 * 60 * 60 * 1000)) : 0;
    }
    function openNameModal() {
        var m = openModal('Change Name');
        m.body.appendChild(el('p', 'text-body-medium content-sub', 'Important: Your display name can only be changed once every 7 days'));
        var field = el('div');
        field.style.cssText = 'display:flex;align-items:center;gap:8px;height:40px;padding:0 8px 0 12px;border:1px solid rgba(128,128,128,.5);border-radius:8px;';
        var input = el('input'); input.type = 'text'; input.maxLength = 20;
        input.value = displayName(current); input.placeholder = displayName(current);
        input.style.cssText = 'flex:1;min-width:0;background:none;border:0;outline:0;color:inherit;font:inherit;';
        var clear = el('button', '', '×'); clear.type = 'button'; clear.setAttribute('aria-label', 'Clear text');
        clear.style.cssText = 'background:none;border:0;color:inherit;font-size:20px;line-height:1;cursor:pointer;padding:0 4px;';
        field.appendChild(input); field.appendChild(clear);
        var err = el('span', 'text-alert'); err.style.color = '#d93025';
        var count = el('span', 'text-caption-small content-sub');
        var foot = el('div'); foot.style.cssText = 'display:flex;justify-content:space-between;gap:12px;margin-top:-8px;';
        foot.appendChild(err); foot.appendChild(count);
        var save = actionButton('Save');
        function sync() {
            var v = input.value.trim(), days = nameCooldownDays();
            count.textContent = input.value.length + '/20';
            input.disabled = clear.disabled = days > 0;
            err.textContent = days > 0 ? 'You can change your display name again in ' + days + (days === 1 ? ' day.' : ' days.') : '';
            setEnabled(save, days === 0 && v.length > 0 && v !== displayName(current));
        }
        input.addEventListener('input', sync);
        clear.addEventListener('click', function () { input.value = ''; sync(); input.focus(); });
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); save.click(); } });
        save.addEventListener('click', function () {
            if (save.disabled) return;
            saveAccount({ displayName: input.value.trim(), displayNameChangedAt: Date.now() });
            renderProfile();
            m.close();
        });
        m.body.appendChild(field); m.body.appendChild(foot); m.body.appendChild(save);
        sync();
        if (!input.disabled) { input.focus(); input.select(); }
    }

    // Profile frame: pick one; the Change button is grey until the pick differs from the saved frame, then blue.
    // Frames have no PNGs yet, so Change says "Coming soon".
    function openFrameModal() {
        var m = openModal('Profile frame');
        var picked = frameById(current.frame).id;
        var grid = el('div'); grid.style.cssText = 'display:flex;flex-wrap:wrap;gap:12px;';
        var tiles = FRAMES.map(function (f) {
            var t = el('button', 'rbxtest-frame-tile'); t.type = 'button';
            var thumb = el('div', 'rbxtest-frame-thumb', f.id === 'none' ? '⊘' : '');
            t.appendChild(thumb); t.appendChild(el('span', 'text-body-medium', f.label));
            t.addEventListener('click', function () { picked = f.id; sync(); });
            grid.appendChild(t);
            return t;
        });
        var bar = el('div', 'radius-medium stroke-standard stroke-default flex items-center justify-between');
        bar.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:10px 20px;border:1px solid rgba(128,128,128,.4);border-radius:8px;';
        var label = el('span', 'content-emphasis text-body-medium');
        var change = actionButton('Change');
        bar.appendChild(label); bar.appendChild(change);
        var status = el('p', 'text-body-medium content-sub'); status.setAttribute('role', 'status');
        function sync() {
            tiles.forEach(function (t, i) { t.setAttribute('aria-pressed', String(FRAMES[i].id === picked)); });
            label.textContent = 'Selected: ' + frameById(picked).label;
            setEnabled(change, picked !== frameById(current.frame).id);
            status.textContent = '';
        }
        change.addEventListener('click', function () {
            if (change.disabled) return;
            var f = frameById(picked);
            if (!f.png) { status.textContent = 'Coming soon'; return; }
            saveAccount({ frame: f.id });
            renderProfile();
            m.close();
        });
        m.body.appendChild(grid); m.body.appendChild(bar); m.body.appendChild(status);
        sync();
    }

    // "..." menu next to Edit profile. Your own profile shows Inventory and Favorites;
    // other people's profiles show the longer list (no other profile pages exist yet, so only isOwn=true is used).
    var MENU_CLS = 'relative clip group/interactable focus-visible:outline-focus disabled:outline-none foundation-web-menu-item flex items-center content-default text-truncate-split focus-visible:hover:outline-none cursor-pointer stroke-none bg-none text-align-x-left width-full text-body-medium padding-x-medium padding-y-small gap-x-medium radius-medium';
    function menuItem(label, href) {
        var n = el(href ? 'a' : 'button', MENU_CLS);
        if (href) { n.href = href; n.target = '_blank'; n.rel = 'noreferrer'; } else n.type = 'button';
        n.setAttribute('role', 'menuitem');
        n.style.cssText = 'display:flex;align-items:center;width:100%;box-sizing:border-box;padding:8px 12px;border:0;background:none;color:inherit;font:inherit;text-align:left;text-decoration:none;cursor:pointer;border-radius:8px;';
        n.appendChild(el('span', 'foundation-web-menu-item-title text-no-wrap text-truncate-split content-emphasis', label));
        n.addEventListener('mouseenter', function () { n.style.background = 'rgba(128,128,128,.18)'; });
        n.addEventListener('mouseleave', function () { n.style.background = 'none'; });
        return n;
    }
    function buildMenu(isOwn) {
        var menu = el('div', 'foundation-web-menu bg-surface-100 stroke-standard stroke-default shadow-transient-high radius-large');
        menu.setAttribute('role', 'menu');
        menu.style.cssText = 'position:fixed;z-index:100002;min-width:180px;padding:6px;border:1px solid rgba(128,128,128,.4);border-radius:12px;background:var(--color-surface-0,#fff);color:var(--color-content-default,inherit);box-shadow:0 8px 24px rgba(0,0,0,.25);';
        var group = el('div', 'padding-small'); group.setAttribute('role', 'group');
        var soon = function () { rbxShell.toast('Coming soon'); menu.remove(); };
        var items = isOwn
            ? [menuItem('Inventory', 'https://www.roblox.com/users/inventory'), menuItem('Favorites', 'https://www.roblox.com/users/favorites')]
            : ['Send Robux', 'Follow', 'Add trusted friend', 'Trade items', 'Inventory', 'Favorites', 'Block user', 'Report abuse'].map(function (l) {
                var b = menuItem(l); b.addEventListener('click', soon); return b;
            });
        items.forEach(function (i) { group.appendChild(i); });
        menu.appendChild(group);
        return menu;
    }
    function setupMoreMenu() {
        var open = null;
        function close() { if (open) { open.menu.remove(); open.btn.setAttribute('aria-expanded', 'false'); open = null; } }
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('#profile-area button[aria-label="Open contextual menu"]');
            if (!btn) { if (!(e.target.closest && e.target.closest('[role="menu"]'))) close(); return; }
            var same = open && open.btn === btn;
            close();
            if (same) return;
            var menu = buildMenu(!viewed);
            document.body.appendChild(menu);
            var r = btn.getBoundingClientRect();
            menu.style.top = (r.bottom + 6) + 'px';
            menu.style.left = Math.max(8, Math.min(r.right - menu.offsetWidth, window.innerWidth - menu.offsetWidth - 8)) + 'px';
            btn.setAttribute('aria-expanded', 'true');
            open = { menu: menu, btn: btn };
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        window.addEventListener('resize', close);
        window.addEventListener('scroll', close, true);
    }

    // Edit profile rows: Name, About, Profile frame open their dialogs; Username and Edit avatar say "Coming soon".
    function setupEditModals() {
        var soon = function () { if (window.rbxShell) rbxShell.toast('Coming soon'); };
        var handlers = { 'Name': openNameModal, 'About': openBioModal, 'Profile frame': openFrameModal, 'Username': soon, 'Edit avatar': soon };
        document.querySelectorAll('#edit-user-profile-web-app li > button').forEach(function (btn) {
            var t = btn.querySelector('.text-title-large');
            var fn = t && handlers[t.textContent.trim()];
            if (fn) btn.addEventListener('click', function (e) { e.preventDefault(); fn(); });
        });
        var editBio = document.querySelector('#about-dialog .edit-bio-btn');
        if (editBio) editBio.addEventListener('click', openBioModal);
    }

    // "more" under the bio opens the About dialog (About, Social links, Previous names, Statistics)
    function setupAboutDialog() {
        var dlg = document.getElementById('about-dialog');
        if (!dlg) return;
        var lastFocus = null;
        function open() {
            lastFocus = document.activeElement;
            dlg.hidden = false;
            document.body.style.overflow = 'hidden';
            var c = dlg.querySelector('.rbxtest-dialog-close');
            if (c) c.focus();
        }
        function close() {
            dlg.hidden = true;
            document.body.style.overflow = '';
            if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest) return;
            if (e.target.closest('#profile-area .more-btn')) { e.preventDefault(); open(); return; }
            if (!dlg.hidden && (e.target === dlg || e.target.closest('.rbxtest-dialog-close'))) close();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !dlg.hidden) close(); });
    }

    // "Edit profile" opens the edit-profile page (same page, #edit-profile); "Back to Profile" returns
    function setupEditProfile() {
        var edit = document.getElementById('edit-user-profile-web-app');
        var prof = document.querySelector('.profile-platform-container');
        if (!edit || !prof) return;
        function render() {
            var on = location.hash === '#edit-profile';
            edit.hidden = !on;
            prof.hidden = on;
            if (on) window.scrollTo(0, 0);
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest) return;
            if (e.target.closest('#user-profile-header-EditProfile, #user-profile-header-EditProfile-mobile')) {
                e.preventDefault(); location.hash = 'edit-profile';
            } else if (e.target.closest('#edit-profile-back')) {
                e.preventDefault(); location.hash = 'profile';
            }
        });
        window.addEventListener('hashchange', render);
        render();
    }

    function run(account) {
        // accounts created before join dates were stored get today's date saved once, so it stops changing
        if (!account.created) saveAccount({ created: new Date().toISOString() });
        if (viewed) prepareViewMode();
        if (window.loadAccountAvatar) window.loadAccountAvatar(current);   // existing male/female avatar-selection logic
        renderProfile();   // name, @handle, bio, join date, frame
        applyWearing();
        updatePresence();
        setupTabs();
        setupCarouselArrow();
        setupAboutDialog();
        if (!viewed) { setupEditProfile(); setupEditModals(); }
        setupMoreMenu();
        if (viewed) setInterval(updatePresence, 5000);
    }

    function init() {
        var session = readSession();
        var acc = session && readJSON(localStorage, ACCOUNTS_KEY, {})[session.username];
        var fail = function () {
            sessionStorage.removeItem(SESSION_KEY); localStorage.removeItem(SESSION_KEY);
            window.location.replace('index.html');
        };
        if (!acc) return fail();
        tokenHash(session.token).then(function (hash) {
            if ((acc.tokenHashes || []).indexOf(hash) === -1) return fail();
            userKey = session.username; current = acc;
            var want = (new URLSearchParams(location.search).get('u') || '').toLowerCase();
            if (want && want !== String(session.username).toLowerCase()) {
                var all = readJSON(localStorage, ACCOUNTS_KEY, {});
                Object.keys(all).forEach(function (k) { if (String(all[k].username).toLowerCase() === want) viewed = all[k]; });
                // an unknown or banned player has no profile page: go to YOUR OWN profile (with Edit avatar / Edit profile)
                if (!viewed || viewed.banned === true || /roblox/i.test(String(viewed.username || ''))) {
                    window.location.replace('profileview.devtools' + (location.hash || ''));
                    return;
                }
            }
            document.documentElement.classList.remove('rbx-auth-pending');
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { run(acc); }); else run(acc);
        }, fail);
    }
    init();
})();
</script>
