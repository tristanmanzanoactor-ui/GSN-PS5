<script id="rbxtest-home-extras">
(function () {
    function ready(fn) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn); else fn(); }
    function soon() { if (window.rbxShell) rbxShell.toast('Coming soon'); }
    ready(function () {
        // header search is not available yet
        document.addEventListener('submit', function (e) {
            if (e.target.closest && e.target.closest('[data-testid="navigation-search-input"]')) { e.preventDefault(); soon(); }
        }, true);

        // ---- header popups (settings menu, notifications) ----
        var open = null;   // { id, node }
        function closePopup() { if (open) { open.node.remove(); open = null; } }
        function showPopup(id, anchor, node) {
            node.id = id;
            document.body.appendChild(node);
            var r = anchor.getBoundingClientRect();
            node.style.top = (r.bottom + 6) + 'px';
            node.style.left = Math.max(8, Math.min(r.right - node.offsetWidth, window.innerWidth - node.offsetWidth - 8)) + 'px';
            open = { id: id, node: node };
        }
        var BOX = 'position:fixed;z-index:1050;border:1px solid rgba(128,128,128,.4);border-radius:12px;background:var(--color-surface-0,#fff);color:var(--color-content-default,inherit);box-shadow:0 8px 24px rgba(0,0,0,.25);';
        var ITEM_CLS = 'relative clip group/interactable focus-visible:outline-focus disabled:outline-none foundation-web-menu-item flex items-center content-default text-truncate-split focus-visible:hover:outline-none cursor-pointer stroke-none bg-none text-align-x-left width-full text-body-large padding-x-large padding-y-medium gap-x-large radius-medium';
        function item(label, onClick, href) {
            var n = document.createElement(href ? 'a' : 'button');
            n.className = ITEM_CLS; n.setAttribute('role', 'menuitem');
            if (href) { n.href = href; n.target = '_blank'; n.rel = 'noreferrer'; } else n.type = 'button';
            n.style.cssText = 'display:flex;align-items:center;width:100%;box-sizing:border-box;padding:12px 16px;border:0;border-radius:8px;background:none;color:inherit;font:inherit;text-align:left;text-decoration:none;cursor:pointer;white-space:nowrap;';
            var t = document.createElement('span');
            t.className = 'foundation-web-menu-item-title text-no-wrap text-truncate-split content-emphasis';
            t.textContent = label; n.appendChild(t);
            n.addEventListener('mouseenter', function () { n.style.background = 'rgba(128,128,128,.18)'; });
            n.addEventListener('mouseleave', function () { n.style.background = 'none'; });
            if (onClick) n.addEventListener('click', function (e) { closePopup(); onClick(e); });
            return n;
        }
        function settingsMenu() {
            var menu = document.createElement('div');
            menu.className = 'foundation-web-menu bg-surface-100 stroke-standard stroke-default shadow-transient-high radius-large nav-foundation-menu';
            menu.setAttribute('role', 'menu'); menu.style.cssText = BOX + 'min-width:220px;padding:6px;';
            var group = document.createElement('div'); group.setAttribute('role', 'group'); group.className = 'padding-small';
            [item('Settings', soon),
             item('Quick Sign In', soon),
             item('Help & Safety', null, 'https://www.roblox.com/help-safety'),
             item('Switch Accounts', function () { rbxShell.openSwitchAccounts(); }),
             item('Logout', null)   // the click is picked up by the existing log-out confirmation
            ].forEach(function (i) { group.appendChild(i); });
            menu.appendChild(group);
            return menu;
        }
        function notificationsPanel() { return rbxShell.buildNotificationsPanel(BOX); }
        document.addEventListener('click', function (e) {
            var t = e.target.closest ? e.target : e.target.parentElement;
            var gear = t.closest('#navbar-settings, #nav-settings');
            var bell = t.closest('#navbar-stream, #nav-ns-icon, #common-notification-bell');
            var which = gear ? 'rbxtest-gear-menu' : bell ? 'rbxtest-notifications' : null;
            if (!which) { if (!t.closest('#rbxtest-gear-menu, #rbxtest-notifications')) closePopup(); return; }
            e.preventDefault(); e.stopPropagation();
            var same = open && open.id === which;
            closePopup();
            if (same) return;
            var anchor = gear || bell;
            showPopup(which, anchor, gear ? settingsMenu() : notificationsPanel());
        }, true);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePopup(); });
        window.addEventListener('resize', closePopup);
    });
})();
</script>
<script id="rbxtest-home-friends-script">
document.addEventListener('DOMContentLoaded', function () {
    var host = document.getElementById('rbxtest-home-friends');
    if (!host || !window.rbxShell) return;
    var esc = rbxShell.esc;
    function render() {
        var me = rbxShell.currentAccount();
        var all = rbxShell.readAccounts();
        var list = rbxShell.friendsOf(me).map(function (u) { return all[u]; }).filter(function (a) { return a && !rbxShell.isBanned(a); });
        
        var tiles = '<div class="friends-carousel-tile"><button type="button" id="friend-tile-button"><a href="friends.devtools#!/friend-requests" data-testid="friends-carousel-add"><div class="add-friends-icon-container"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-filled-plus-large size-[var(--icon-size-xlarge)] add-friends-icon content-secondary"></span></div><div class="friends-carousel-tile-labels" data-testid="friends-carousel-tile-labels"><div class="friends-carousel-tile-label"><div class="friends-carousel-tile-name"><span class="friends-carousel-display-name">Add Friends</span></div></div></div></a></button></div>' +
            list.map(function (f) {
                var on = rbxShell.isOnline(f.username);
                var href = 'profileview.devtools?u=' + encodeURIComponent(f.username);
                return '<div><div class="friends-carousel-tile"><div><button type="button" class="options-dropdown" id="friend-tile-button"><div class="friend-tile-content"><div class="avatar avatar-card-fullbody" data-testid="avatar-card-container"><a href="' + href + '" class="avatar-card-link" data-testid="avatar-card-link"><span class="thumbnail-2d-container avatar-card-image"><img class="" src="' + esc(window.avatarFileForAccount ? window.avatarFileForAccount(f) : '') + '" alt=""></span></a><div class="avatar-status">' + (on ? '<span class="icon-online" title="Online"></span>' : '') + '</div></div><a href="' + href + '" class="friends-carousel-tile-labels" data-testid="friends-carousel-tile-labels"><div class="friends-carousel-tile-label"><div class="friends-carousel-tile-name"><span class="friends-carousel-display-name">' + esc(rbxShell.displayName(f)) + '</span></div></div><div class="friends-carousel-tile-sublabel"></div></a></div></button></div></div></div>';
            }).join('');
        var html = '<div class="react-friends-carousel-container"><div class="container-header people-list-header"><h2>Friends<span class="friends-count">(' + list.length + ')</span></h2><a href="friends.devtools#!/friends" class="btn-secondary-xs btn-more see-all-link-icon">See All</a></div><div><div class="friends-carousel-container"><div class="friends-carousel-list-container">' + tiles + '</div></div></div></div>';
        if (host.getAttribute('data-sig') !== html) { host.innerHTML = html; host.setAttribute('data-sig', html); }
    }
    render();
    setInterval(render, 5000);
    window.addEventListener('storage', render);
    window.addEventListener('pageshow', render);
});
</script>
</body>
</html>
