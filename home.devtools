<style id="rbxtest-home-styles">
html.rbx-auth-pending body { visibility: hidden; }
#rbxtest-profile { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; }
#rbxtest-profile a.rbxtest-profile-link { text-decoration: none; }
#rbxtest-profile .avatar-headshot-xs { display: inline-block; position: relative; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; }
#rbxtest-profile .thumbnail-2d-container.avatar-card-image, a[href="/users/profile"] .thumbnail-2d-container { display: block; width: 100%; height: 100%; overflow: hidden; }
.profile-avatar { width: 100%; height: 100%; object-fit: cover; display: block; }
/* make sure the PNG is really visible (no loading shimmer / hidden state from the site's own CSS) */
[data-rbx-avatar] { display: block !important; position: relative !important; overflow: hidden !important; border-radius: inherit; background-image: none !important; }
[data-rbx-avatar]::before, [data-rbx-avatar]::after { display: none !important; content: none !important; }
[data-rbx-avatar] > img.profile-avatar { display: block !important; visibility: visible !important; opacity: 1 !important; width: 100% !important; height: 100% !important; max-width: none !important; object-fit: cover !important; position: relative; z-index: 1; }
#rbxtest-logout { cursor: pointer; padding: 8px 16px; border-radius: 8px; border: 1px solid rgba(128,128,128,.5); background: transparent; color: inherit; font-weight: 600; }
#rbxtest-logout-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; z-index: 100000; }
#rbxtest-logout-overlay[hidden] { display: none; }
#rbxtest-logout-overlay .modal-dialog { position: relative !important; inset: auto !important; transform: none !important; margin: 0 !important; display: block !important; opacity: 1 !important; visibility: visible !important; width: 420px; max-width: 92vw; color: #f7f7f8; }
#rbxtest-logout-overlay .modal-content { background: #232527; color: #f7f7f8; border: 0; border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.5); padding: 20px; position: relative; }
#rbxtest-logout-overlay .modal-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
#rbxtest-logout-overlay .modal-title { margin: 0; font-size: 20px; }
#rbxtest-logout-overlay .close { background: none; border: 0; color: inherit; font-size: 22px; cursor: pointer; line-height: 1; }
#rbxtest-logout-overlay .close .icon-close::before { content: "\00d7"; }
#rbxtest-logout-overlay .verification-upsell-text-body { margin: 12px 0; font-size: 14px; line-height: 20px; }
#rbxtest-logout-overlay .verification-upsell-modal-input { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #555; background: #1a1c1e; color: inherit; box-sizing: border-box; }
#rbxtest-logout-overlay .verification-upsell-footer-container { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
#rbxtest-logout-overlay .verification-upsell-btn { padding: 10px; border-radius: 8px; border: 0; background: #335fff; color: #fff; font-weight: 600; cursor: pointer; }
#rbxtest-logout-overlay .change-email-button { background: none; border: 0; color: #9db4ff; cursor: pointer; text-decoration: underline; font-size: 14px; }
</style>

<script src="shell.js" defer></script>
<script id="rbxtest-avatar-detect">
/* AVATAR DETECTION SCRIPT
   Signup saves account.selectedCharacter = "male" | "female" (see index.html).
   This script detects the logged-in account, reads that saved choice and puts the matching avatar URL
   (male -> proud-river worker, female -> green-leaf worker) into the <img> inside EVERY
   .thumbnail-2d-container.avatar-card-image on the page, now and whenever the site redraws one. */
(function () {
    var URLS = {
        male: 'https://proud-river-a3e7.tristan-manzano-actor.workers.dev/',
        female: 'https://green-leaf-a836.tristan-manzano-actor.workers.dev/'
    };
    var SELECTOR = '.thumbnail-2d-container.avatar-card-image';
    var EXTRA = 'a[href="/users/profile"] .thumbnail-2d-container, a[href^="/users/"][href$="/profile"] .thumbnail-2d-container, #header .avatar-headshot .thumbnail-2d-container, #header .avatar-headshot-xs .thumbnail-2d-container';

    function readJSON(storage, key) {
        try { return JSON.parse(storage.getItem(key)); } catch (e) { return null; }
    }
    // 1) the current logged-in account (session -> saved account)
    function detectCurrentAccount() {
        var session = readJSON(sessionStorage, 'rbxtest_session') || readJSON(localStorage, 'rbxtest_session');
        if (!session || !session.username) return null;
        var accounts = readJSON(localStorage, 'rbxtest_accounts') || {};
        return accounts[session.username] || null;
    }
    // 2) its saved selectedCharacter -> the avatar URL
    function avatarFileForAccount(account) {
        var choice = String((account && (account.selectedCharacter || account.character)) || '').toLowerCase();
        return choice === 'female' ? URLS.female : URLS.male;
    }

    function setAvatar(container, file) {
        var only = container.children.length === 1 ? container.firstElementChild : null;
        if (only && only.tagName === 'IMG' && only.getAttribute('data-avatar-file') === file ) return;   // already correct
        var img = document.createElement('img');
        img.className = 'profile-avatar';
        img.setAttribute('data-avatar-file', file);
        img.alt = 'FigureBlox avatar';
        img.src = file;
        container.setAttribute('data-rbx-avatar', 'true');
        Array.prototype.slice.call(container.classList).forEach(function (c) {
            if (/shimmer|loading|broken|placeholder/i.test(c)) container.classList.remove(c);
        });
        container.replaceChildren(img);
    }
    // 3) put the PNG into both (all) avatar locations
    function loadAccountAvatar(currentAccount) {
        currentAccount = currentAccount || detectCurrentAccount();
        if (!currentAccount) return;
        var file = avatarFileForAccount(currentAccount);
        var seen = [];
        var list = Array.prototype.slice.call(document.querySelectorAll(SELECTOR))
            .concat(Array.prototype.slice.call(document.querySelectorAll(EXTRA)));
        list.forEach(function (container) {
            if (seen.indexOf(container) !== -1) return;
            seen.push(container);
            setAvatar(container, file);
        });
    }
    window.detectCurrentAccount = detectCurrentAccount;
    window.avatarFileForAccount = avatarFileForAccount;
    window.loadAccountAvatar = loadAccountAvatar;

    // run now, when the DOM is ready, when everything has loaded, and whenever the site re-renders an avatar
    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        (window.requestAnimationFrame || setTimeout)(function () { queued = false; loadAccountAvatar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule); else schedule();
    window.addEventListener('load', schedule);
    new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script id="rbxtest-account-home">
document.documentElement.classList.add('rbx-auth-pending');   // hidden until the saved session is verified
(function () {
    // Avatar URLs are defined in the dedicated avatar script (#rbxtest-avatar-detect) above.
    var AVATAR_FILES = {
        male: 'https://proud-river-a3e7.tristan-manzano-actor.workers.dev/',
        female: 'https://green-leaf-a836.tristan-manzano-actor.workers.dev/'
    };
    function getAccountAvatar(account) {
        return window.avatarFileForAccount ? window.avatarFileForAccount(account) : AVATAR_FILES.male;
    }
    // Avatar rendering lives in the dedicated avatar detection script (#rbxtest-avatar-detect) above.
    function updateProfileAvatar(currentAccount) {
        if (window.loadAccountAvatar) window.loadAccountAvatar(currentAccount);
    }

    // ---------- Saved accounts + session (same storage as index.html; no passwords stored) ----------
    var ACCOUNTS_KEY = 'rbxtest_accounts', SESSION_KEY = 'rbxtest_session', REMEMBERED_KEY = 'rbxtest_remembered';
    function readJSON(storage, key, fallback) {
        try { var v = JSON.parse(storage.getItem(key)); return v === null || v === undefined ? fallback : v; } catch (e) { return fallback; }
    }
    function readAccounts() { return readJSON(localStorage, ACCOUNTS_KEY, {}); }
    function readSession() {
        var stores = [sessionStorage, localStorage];
        for (var i = 0; i < stores.length; i++) {
            var s = readJSON(stores[i], SESSION_KEY, null);
            if (s && typeof s === 'object' && s.username && s.token) return s;
        }
        return null;
    }
    function sha256Hex(text) {
        if (window.crypto && crypto.subtle) {
            return crypto.subtle.digest('SHA-256', new TextEncoder().encode(text)).then(function (buf) {
                return Array.prototype.map.call(new Uint8Array(buf), function (b) { return ('0' + b.toString(16)).slice(-2); }).join('');
            });
        }
        var h = 5381;
        for (var i = 0; i < text.length; i++) h = ((h << 5) + h + text.charCodeAt(i)) >>> 0;
        return Promise.resolve('weak-' + h.toString(16));
    }
    function tokenHash(token) { return sha256Hex('session:' + token); }

    var account = null, session = null;
    function esc(t) { return String(t).replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

    function setMeta() {
        var meta = document.querySelector('meta[name="user-data"]');
        if (meta) {
            meta.setAttribute('data-name', account.username);
            meta.setAttribute('data-displayName', account.displayName || account.username);
        }
    }

    // Profile (avatar uses the existing avatar / avatar-headshot-xs / thumbnail-2d-container avatar-card-image structure)
    function profileHTML() {
        return '<a href="/users/profile" class="rbxtest-profile-link content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none" style="display:flex;align-items:center;gap:8px;">'
          + '<div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div>'
          + '<span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center">'
          + '<span class="avatar avatar-headshot-xs"><span class="thumbnail-2d-container avatar-card-image">'
          + '<img class="profile-avatar" id="rbxtest-avatar" src="' + getAccountAvatar(account) + '" alt="Profile avatar"></span></span></span>'
          + '<span class="flex flex-col gap-xsmall min-width-0 large:flex-row large:align-items-center"><span class="flex gap-xsmall min-width-0 align-items-center">'
          + '<span id="rbxtest-username" class="text-truncate-end text-no-wrap">' + esc(account.username) + '</span></span></span></a>';
    }

    // The profile link (avatar + username) and the "Log Out" button are intentionally no longer added to the page.
    function buildProfile() {
        var old = document.getElementById('rbxtest-profile');
        if (old) old.remove();
    }

    // If the site's own scripts render a profile link, make it show this account too.
    function patchNativeProfile() {
        updateProfileAvatar(account);
    }

    // Remove the account-setup prompt and any "Unchecked" badge (and wrappers left empty)
    var REMOVE = ['set up your account', 'unlock chat and more games with an age check.', 'unchecked'];
    function norm(t) { return (t || '').replace(/\s+/g, ' ').trim().toLowerCase(); }
    function stripSetupPrompt(root) {
        if (!root) return;
        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
        var hits = [], node;
        while ((node = walker.nextNode())) {
            if (REMOVE.indexOf(norm(node.nodeValue)) !== -1) hits.push(node);
        }
        hits.forEach(function (textNode) {
            var el = textNode.parentElement;
            if (!el || el.closest('#rbxtest-logout-overlay')) return;
            var top = el;
            while (top.parentElement && top.parentElement !== document.body) {
                var rest = norm(top.parentElement.textContent);
                REMOVE.forEach(function (r) { rest = rest.split(r).join(''); });
                var onlyRemovable = rest.replace(/\s+/g, '') === '';
                if (!onlyRemovable || top.parentElement.id === 'content' || top.parentElement.tagName === 'MAIN') break;
                top = top.parentElement;
            }
            top.remove();
        });
    }

    // ---- Log out confirmation modal ----
    var overlay = null;
    function buildModal() {
        overlay = document.createElement('div');
        overlay.id = 'rbxtest-logout-overlay';
        overlay.hidden = true;
        overlay.innerHTML = '<div role="dialog" id="radix-0" aria-labelledby="radix-1" data-state="open" class="relative radius-large bg-surface-100 stroke-muted stroke-standard foundation-web-dialog-content shadow-transient-high modal-dialog" data-size="Large" tabindex="-1" style="background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; pointer-events: auto;">'
          + '<div class="modal-content">'
          + '<div class="modal-header"><div class="verification-upsell-title-container"><h4 id="verification-upsell-modal-title" class="modal-title">Finish Account Setup Before Log Out</h4></div>'
          + '<button type="button" class="close close-button"><span class="icon-close"></span></button></div>'
          + '<div class="modal-body"><div class="email-verification-upsell-image"></div>'
          + '<p class="verification-upsell-text-body">Finish setting up your account by adding an email for account recovery. By skipping this step, you are accepting that you may lose access to any game progress, items, and Robux.</p>'
          + '<input type="email" class="form-control input-field verification-upsell-modal-input" placeholder="Your Email" autocomplete="email" value=""></div>'
          + '<div class="modal-footer"><div class="verification-upsell-footer-container">'
          + '<button type="button" class="modal-button verification-upsell-btn btn-cta-md btn-min-width">Finish Setup</button>'
          + '<button type="button" class="change-email-button">Accept Risk of Losing Account and Log Out</button></div></div>'
          + '</div></div>';
        document.body.appendChild(overlay);
        overlay.querySelector('.close-button').addEventListener('click', closeLogoutModal);
        overlay.addEventListener('mousedown', function (e) { if (e.target === overlay) closeLogoutModal(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay && !overlay.hidden) closeLogoutModal(); });
        overlay.querySelector('.change-email-button').addEventListener('click', logOut);
        overlay.querySelector('.verification-upsell-btn').addEventListener('click', function () {
            var input = overlay.querySelector('.verification-upsell-modal-input');
            if (!input.checkValidity() || !input.value.trim()) { input.focus(); return; }
            var accounts = readAccounts();
            if (accounts[session.username]) {
                accounts[session.username].email = input.value.trim();
                localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(accounts));
            }
            closeLogoutModal();
        });
    }
    function openLogoutModal() {
        if (!overlay) buildModal();
        overlay.hidden = false;
        overlay.style.display = 'flex';
        overlay.querySelector('.close-button').focus();
    }
    function closeLogoutModal() { if (overlay) { overlay.hidden = true; overlay.style.display = 'none'; } }

    // Ends the session only. The account (and any "remembered account" entry) is kept for future logins,
    // and nothing signs the user back in automatically.
    function logOut() {
        var current = readSession();
        try { if (window.rbxShell) rbxShell.markOffline(); } catch (e) {}
        try { if (window.rbxShell && current) rbxShell.forgetAccount(current.username); } catch (e) {}
        sessionStorage.removeItem(SESSION_KEY);
        localStorage.removeItem(SESSION_KEY);
        var done = function () { window.location.replace('index.html'); };
        if (!current) return done();
        var remembered = readJSON(localStorage, REMEMBERED_KEY, []);
        var keepToken = Array.isArray(remembered) && remembered.some(function (r) { return r.username === current.username && r.token === current.token; });
        if (keepToken) return done();
        tokenHash(current.token).then(function (hash) {
            var accounts = readAccounts(), acc = accounts[current.username];
            if (acc && acc.tokenHashes) {
                acc.tokenHashes = acc.tokenHashes.filter(function (h) { return h !== hash; });
                localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(accounts));
            }
            done();
        }, done);
    }
    // The existing Log Out control (ours or the site's own: link, button, menu item...) opens the same confirmation.
    function findLogOutControl(start) {
        var n = start, depth = 0;
        while (n && n !== document.body && n !== document.documentElement && depth < 5) {
            if (n.nodeType === 1) {
                if (n.id === 'rbxtest-logout-overlay') return null;
                var text = norm(n.textContent);
                var hints = (n.id || '') + ' ' + (n.getAttribute('href') || '') + ' ' + (n.getAttribute('data-testid') || '') + ' ' + (n.getAttribute('aria-label') || '');
                if (/^log ?out$/.test(text) || /log-?out|sign-?out/i.test(hints)) return n;
            }
            n = n.parentElement; depth += 1;
        }
        return null;
    }
    function interceptLogOut(e) {
        var el = findLogOutControl(e.target && e.target.nodeType === 1 ? e.target : (e.target && e.target.parentElement));
        if (!el) return;
        e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
        if (e.type === 'click') openLogoutModal();
    }
    // capture phase, so the site's own logout handler never runs first
    document.addEventListener('click', interceptLogOut, true);
    document.addEventListener('submit', function (e) {
        if (/log-?out/i.test(e.target.getAttribute && (e.target.getAttribute('action') || '') || '')) { e.preventDefault(); e.stopPropagation(); openLogoutModal(); }
    }, true);

    // Another tab logged in / out / switched account -> reload so this tab shows the right account.
    window.addEventListener('storage', function (e) {
        if (e.key === SESSION_KEY || e.key === null) window.location.reload();
    });

    function run() {
        setMeta(); buildProfile(); updateProfileAvatar(account); patchNativeProfile(); stripSetupPrompt(document.body);
        new MutationObserver(function () { patchNativeProfile(); stripSetupPrompt(document.body); })
            .observe(document.documentElement, { childList: true, subtree: true, characterData: true });
    }

    // Verify the saved session, then show the profile for THAT account.
    function init() {
        session = readSession();
        var acc = session && readAccounts()[session.username];
        var fail = function () {
            sessionStorage.removeItem(SESSION_KEY); localStorage.removeItem(SESSION_KEY);
            window.location.replace('index.html');
        };
        if (!acc) return fail();
        tokenHash(session.token).then(function (hash) {
            if ((acc.tokenHashes || []).indexOf(hash) === -1) return fail();
            account = acc;
            if (!account.selectedCharacter && account.character) account.selectedCharacter = account.character;  // older saves
            document.documentElement.classList.remove('rbx-auth-pending');
            window.__rbxtestAuthed = true; document.dispatchEvent(new Event('rbxtest-authenticated'));
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
        }, fail);
    }
    init();
})();
</script>


