<script id="rbxtest-profile-route">
/* Routes every profile link (/users/profile or /users/<id>/profile, relative or on any host,
   including the workers.dev address the page is served from) to the local profileview.devtools page. */
(function () {
    var TARGET = 'profileview.devtools';
    function isProfile(a) {
        var h = a.getAttribute && a.getAttribute('href');
        if (!h || h === TARGET) return false;
        var path;
        try { path = new URL(h, window.location.href).pathname; } catch (e) { return false; }
        return /^\/users\/(\d+\/)?profile\/?$/.test(path);
    }
    function patch(root) {
        (root.querySelectorAll ? root.querySelectorAll('a[href*="/users/"]') : []).forEach(function (a) {
            if (isProfile(a)) a.setAttribute('href', TARGET);
        });
    }
    document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a || !isProfile(a)) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.ctrlKey || e.metaKey || a.target === '_blank') window.open(TARGET, '_blank');
        else window.location.href = TARGET;
    }, true);
    patch(document);
    new MutationObserver(function () { patch(document); })
        .observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script id="rbxtest-build">
/* Build stamp: open any page with ?build on the end (e.g. profileview.devtools?build) to see which version is being served. */
(function () {
    var BUILD = 'r9-2026-10-04';
    try { console.log('FigureBlox build', BUILD); } catch (e) {}
    if (!/[?&]build\b/.test(location.search)) return;
    var b = document.createElement('div');
    b.textContent = 'build ' + BUILD;
    b.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:2147483647;background:#111;color:#0f0;font:12px monospace;padding:4px 8px;border-radius:4px;';
    document.body.appendChild(b);
})();
</script>
</body>
</html>
