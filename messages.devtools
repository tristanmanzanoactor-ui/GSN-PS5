le focus-visible:outline-focus disabled:outline-none bg-shift-200"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-speech-bubble-align-center size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Messages</span><span class="fill basis-auto padding-x-small flex justify-end items-center"><div class="foundation-web-badge flex items-center select-none gap-[var(--size-150)] radius-circle height-600 width-[fit-content] padding-x-small bg-system-contrast content-inverse-emphasis stroke-none"><span class="text-no-wrap text-truncate-split text-label-small padding-y-xsmall padding-x-xxsmall content-inverse-emphasis">1</span></div></span></a></li><li><a href="friends.devtools" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-two-people size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Friends</span></a></li><li><a href="#" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-person-standing size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Avatar</span></a></li><li><a href="#" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-backpack size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Inventory</span></a></li><li><a href="#" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-hand-two-arrows-horizontal size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Trade</span></a></li><li><a href="#" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-three-people size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Communities</span></a></li><li><a href="#" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-fountain-pen-nib size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Newsroom</span></a></li><li><button type="button" class="bg-none width-full stroke-none content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-building-store size-[var(--icon-size-large)]"></span></span><span>Official Store</span></button></li><li><a href="#" class="content-emphasis text-title-large flex items-center gap-small padding-left-xsmall padding-right-xxsmall radius-medium relative clip group/interactable focus-visible:outline-focus disabled:outline-none"><div role="presentation" class="absolute inset-[0] transition-colors group-hover/interactable:bg-[var(--color-state-hover)] group-active/interactable:bg-[var(--color-state-press)] group-disabled/interactable:bg-none"></div><span class="size-1000 grow-0 shrink-0 basis-auto flex justify-center items-center"><span aria-hidden="true" data-testid="foundation-web-icon" class="grow-0 shrink-0 basis-auto icon icon-regular-gift-card size-[var(--icon-size-large)]"></span></span><span class="min-width-0 text-truncate-end text-no-wrap">Buy Gift Cards</span></a></li></ul></nav></div></div><div role="separator" data-orientation="vertical" aria-orientation="vertical" class="stroke-default self-stretch" style="border-right-width: 0px; border-bottom-width: 0px; box-sizing: border-box; border-style: solid; height: 100%; width: 0px; border-left-width: var(--stroke-standard); border-top-width: 0px;"></div></div></div></div>
</div>
