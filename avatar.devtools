<style id="rbxtest-profileview-styles">
html.rbx-auth-pending body { visibility: hidden; }
.profile-avatar { width: 100%; height: 100%; object-fit: cover; display: block; }
[data-rbx-avatar] { display: block !important; position: relative !important; overflow: hidden !important; border-radius: inherit; background-image: none !important; }
[data-rbx-avatar]::before, [data-rbx-avatar]::after { display: none !important; content: none !important; }
[data-rbx-avatar] > img.profile-avatar { display: block !important; visibility: visible !important; opacity: 1 !important; width: 100% !important; height: 100% !important; max-width: none !important; object-fit: cover !important; position: relative; z-index: 1; }

[hidden] { display: none !important; }
/* Profile header is a normal (non-clickable) block; only its real links/buttons are interactive */
#profile-area a, #profile-area button.more-btn, #profile-area .buttons-show-on-desktop button, #profile-area .buttons-show-on-mobile button { cursor: pointer; }
.profile-header-main { flex: 1 1 auto; color: inherit; font: inherit; text-align: left; }
/* About / Creations / Currently Wearing are always visible, stacked under the header */
#profile-details { display: block; }
#profile-details .profile-section { padding-top: 24px; }
#profile-details .profile-section-title { margin: 0 0 12px; }
#profile-details .profile-about-text { margin: 0; white-space: pre-wrap; font: inherit; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
/* Presence (online) icon: FigureBlox's own .icon-online styling is used; this only keeps it on top of the avatar */
.avatar-card-fullbody, .avatar-headshot-lg .avatar { position: relative; }
.avatar-card-fullbody > .avatar-status { position: absolute; right: 0; bottom: 0; z-index: 5; line-height: 0; pointer-events: none; }
/* only applied by script if FigureBlox's stylesheet did not load (icon would otherwise be invisible) */
.avatar-status.presence-fallback [data-testid="presence-icon"] { display: block; width: 18px; height: 18px; box-sizing: border-box; border-radius: 50%; background: #00b06f; border: 3px solid var(--color-surface-0, #fff); }
/* Profile details: About / Creations tabs (About is selected by default) */
#profile-details, #profile-details[hidden] { display: block !important; visibility: visible !important; }
#profile-details .profile-tabs { list-style: none; margin: 0; padding: 0; display: flex; border-bottom: 1px solid var(--color-divider, rgba(128,128,128,.4)); }
#profile-details .profile-tabs li { flex: 1 1 0; display: flex; justify-content: center; }
#profile-details .profile-tab { text-decoration: none; cursor: pointer; color: inherit; opacity: .75; }
#profile-details .profile-tab.active { opacity: 1; font-weight: 700; box-shadow: inset 0 -2px 0 currentColor; }
#profile-details .profile-tab-content[hidden] { display: none !important; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
.css-1jynqc0-carouselContainer { position: relative; }
.css-1i465w8-carousel { scroll-behavior: smooth; }
.scroll-arrow { position: absolute; top: 50%; right: 0; transform: translateY(-50%); cursor: pointer; z-index: 3; }
.scroll-arrow[hidden] { display: none !important; }
.scroll-arrow.arrow-fallback { width: 36px; height: 36px; border-radius: 50%; background: rgba(40,40,40,.85); color: #fff; display: flex; align-items: center; justify-content: center; }
.scroll-arrow.arrow-fallback .icon-chevron-heavy-right::before { content: "\203A"; font-size: 26px; line-height: 1; }
/* "more" -> About dialog */
.rbxtest-dialog-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100000; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(0,0,0,.6); }
.rbxtest-dialog { position: relative; width: 100%; max-width: 480px; max-height: 85vh; overflow: auto; border-radius: 12px; background: var(--color-surface-0, #fff); color: var(--color-content-default, inherit); }
.rbxtest-dialog-close { position: absolute; top: 8px; right: 12px; z-index: 1; background: none; border: 0; padding: 0 4px; font-size: 28px; line-height: 1; color: inherit; cursor: pointer; }
.rbxtest-dialog .edit-bio-btn { background: none; border: 0; padding: 0; margin-top: 8px; cursor: pointer; color: inherit; text-decoration: underline; }
.profile-platform-container[hidden], #edit-user-profile-web-app[hidden] { display: none !important; }
.profile-setting-row { text-align: left; }
.profile-setting-row-value { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rbxtest-dialog [data-profile-about] { white-space: pre-wrap; overflow-wrap: anywhere; }
#profile-area pre.description-content { white-space: pre-wrap; overflow-wrap: anywhere; }
.rbxtest-frame-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; z-index: 6; }
.rbxtest-frame-tile { width: 92px; padding: 10px 6px; border: 2px solid rgba(128,128,128,.4); border-radius: 12px; background: none; color: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; font: inherit; }
.rbxtest-frame-tile[aria-pressed="true"] { border-color: #335fff; }
.rbxtest-frame-thumb { width: 56px; height: 56px; border-radius: 50%; border: 2px dashed rgba(128,128,128,.6); display: flex; align-items: center; justify-content: center; font-size: 24px; opacity: .8; }
/* fallback layout for the Currently Wearing carousel (its styles are normally injected by FigureBlox's scripts) */
.css-1i465w8-carousel { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }
.css-izzd58-carouselItem, .css-6xn1qo-carouselItem { flex: 0 0 150px; width: 150px; }

</style>
<script src="shell.js" defer></script>
<script id="rbxtest-avatar-detect">
/* AVATAR DETECTION SCRIPT
   Signup saves account.selectedCharacter = "male" | "female" (see index.html).
   This script detects the logged-in account, reads that saved choice and puts the matching avatar URL
   (male -> proud-river worker, female -> green-leaf worker) into the <img> inside EVERY
   .thumbnail-2d-container.avatar-card-image on the page, now and whenever the site redraws one. */
(function () {
    var URLS = {
        male: 'https://proud-river-a3e7.tristan-manzano-actor.workers.dev/',
        female: 'https://green-leaf-a836.tristan-manzano-actor.workers.dev/'
    };
    var SELECTOR = '.thumbnail-2d-container.avatar-card-image';
    var EXTRA = 'a[href="/users/profile"] .thumbnail-2d-container, a[href^="/users/"][href$="/profile"] .thumbnail-2d-container, #header .avatar-headshot .thumbnail-2d-container, #header .avatar-headshot-xs .thumbnail-2d-container';

    function readJSON(storage, key) {
        try { return JSON.parse(storage.getItem(key)); } catch (e) { return null; }
    }
    // 1) the current logged-in account (session -> saved account)
    function detectCurrentAccount() {
        var session = readJSON(sessionStorage, 'rbxtest_session') || readJSON(localStorage, 'rbxtest_session');
        if (!session || !session.username) return null;
        var accounts = readJSON(localStorage, 'rbxtest_accounts') || {};
        return accounts[session.username] || null;
    }
    // 2) its saved selectedCharacter -> the avatar URL
    function avatarFileForAccount(account) {
        var choice = String((account && (account.selectedCharacter || account.character)) || '').toLowerCase();
        return choice === 'female' ? URLS.female : URLS.male;
    }

    function setAvatar(container, file) {
        var only = container.children.length === 1 ? container.firstElementChild : null;
        if (only && only.tagName === 'IMG' && only.getAttribute('data-avatar-file') === file ) return;   // already correct
        var img = document.createElement('img');
        img.className = 'profile-avatar';
        img.setAttribute('data-avatar-file', file);
        img.alt = 'FigureBlox avatar';
        img.src = file;
        container.setAttribute('data-rbx-avatar', 'true');
        Array.prototype.slice.call(container.classList).forEach(function (c) {
            if (/shimmer|loading|broken|placeholder/i.test(c)) container.classList.remove(c);
        });
        container.replaceChildren(img);
    }
    // 3) put the PNG into both (all) avatar locations
    function loadAccountAvatar(currentAccount) {
        currentAccount = currentAccount || detectCurrentAccount();
        if (!currentAccount) return;
        var file = avatarFileForAccount(currentAccount);
        var seen = [];
        var list = Array.prototype.slice.call(document.querySelectorAll(SELECTOR))
            .concat(Array.prototype.slice.call(document.querySelectorAll(EXTRA)));
        list.forEach(function (container) {
            if (seen.indexOf(container) !== -1) return;
            seen.push(container);
            setAvatar(container, file);
        });
    }
    window.detectCurrentAccount = detectCurrentAccount;
    window.avatarFileForAccount = avatarFileForAccount;
    window.loadAccountAvatar = loadAccountAvatar;

    // run now, when the DOM is ready, when everything has loaded, and whenever the site re-renders an avatar
    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        (window.requestAnimationFrame || setTimeout)(function () { queued = false; loadAccountAvatar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule); else schedule();
    window.addEventListener('load', schedule);
    new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<style id="rbxtest-avatar-styles">
#avatar-web-app { max-width: 1000px; margin: 0 auto; padding: 16px; }
#avatar-web-app .avatar-editor-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
#avatar-web-app .avatar-editor-header h1 { margin: 0; }
#avatar-web-app .catalog-header { display: flex; align-items: center; gap: 12px; }
#avatar-web-app .btn-primary-md { display: inline-block; padding: 8px 18px; border-radius: 8px; background: #335fff; color: #fff; font-weight: 600; text-decoration: none; cursor: pointer; }
#avatar-web-app .avatar-layout { display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start; }
#avatar-web-app .left-wrapper { width: 352px; max-width: 100%; }
#avatar-web-app .avatar-thumbnail { position: relative; width: 352px; max-width: 100%; aspect-ratio: 1/1; border-radius: 8px; background: rgba(128,128,128,.18); overflow: hidden; }
#avatar-web-app .avatar-thumbnail img { width: 100%; height: 100%; object-fit: cover; display: block; }
#avatar-web-app .toggle-three-dee { position: absolute; right: 8px; bottom: 8px; min-width: 44px; height: 36px; padding: 0 12px; border: 0; border-radius: 8px; background: rgba(35,37,39,.85); color: #fff; font: 600 14px sans-serif; cursor: pointer; }
#avatar-web-app .redraw-avatar { margin-top: 10px; font-size: 14px; display: flex; gap: 6px; flex-wrap: wrap; }
#avatar-web-app .text-link { background: none; border: 0; padding: 0; color: #335fff; text-decoration: underline; cursor: pointer; font: inherit; }
#avatar-web-app .right-panel { flex: 1; min-width: 300px; }
#avatar-web-app .nav-tabs { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgba(128,128,128,.4); }
#avatar-web-app .rbx-tab-heading { background: none; border: 0; border-bottom: 3px solid transparent; padding: 12px 14px; color: inherit; font: inherit; font-weight: 600; cursor: pointer; opacity: .75; }
#avatar-web-app .rbx-tab.active .rbx-tab-heading { border-bottom-color: #335fff; opacity: 1; }
#avatar-web-app .breadcrumb-container { display: flex; gap: 8px; list-style: none; padding: 12px 0; margin: 0; font-size: 14px; opacity: .75; }
#avatar-web-app .item-cards-stackable { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px; }
#avatar-web-app .item-card-container { position: relative; cursor: pointer; }
#avatar-web-app .item-card-thumb { aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background: rgba(128,128,128,.2); border: 2px solid transparent; }
#avatar-web-app .item-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
#avatar-web-app .item-card-container.is-equipped .item-card-thumb { border-color: #335fff; }
#avatar-web-app .rbxtest-eq { position: absolute; top: 6px; right: 6px; width: 20px; height: 20px; border-radius: 50%; background: #335fff; color: #fff; font-size: 13px; line-height: 20px; text-align: center; }
#avatar-web-app .item-card-name { margin-top: 6px; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#avatar-web-app .bodycolors-list { display: flex; flex-wrap: wrap; gap: 10px; padding: 8px 0; }
#avatar-web-app .color-dot { width: 40px; height: 40px; border-radius: 50%; cursor: pointer; border: 3px solid transparent; box-sizing: border-box; }
#avatar-web-app .color-dot.selected { border-color: #335fff; box-shadow: 0 0 0 2px #fff inset; }
#avatar-web-app .scale-container { display: grid; grid-template-columns: 110px 1fr 50px; align-items: center; gap: 12px; margin: 10px 0; }
#avatar-web-app .scale-container input[type=range] { width: 100%; }
#avatar-web-app .section-content-off { padding: 24px 0; opacity: .75; }
#avatar-web-app h4 { margin: 12px 0 4px; }
</style>
<script id="rbxtest-avatar-page">
document.documentElement.classList.add('rbx-auth-pending');
document.addEventListener('DOMContentLoaded', function () {
    rbxShell.requireLogin(function (acc, key) {
        document.title = 'Avatar - FigureBlox';
        var root = document.getElementById('page-root'), esc = rbxShell.esc;
        function T(h, k) { return 'https://tr.rbxcdn.com/' + h + '/150/150/' + k + '/Webp/noFilter'; }
        function outfit(h, k) { return T('30DAY-' + k + '-' + h + '-Png', k); }
        function asset(h, k) { return T('180DAY-' + h, k); }
        // [name, thumbnail, equipped by default]
        var ITEMS = [
            ['Recolorable Abstract Head w Outline', outfit('CA2E04B9089454F9FB8DCBCB1097DFC7', 'DynamicHeadCostume'), 1],
            ['Recolorable Abstract Liquid Matching Shirt', asset('d2dfc8ec875b677fceba7340d85029d3', 'Shirt'), 1],
            ['R6 Inverted [Recolorable]', outfit('390E9C9A9BB3CA75A4DACBFF25B1E805', 'Avatar'), 0],
            ['R6 Inverted [Recolorable] (Head)', outfit('D2808890CC80B7AE8716A00C54C0997E', 'DynamicHeadCostume'), 0],
            ['Recolorable Abstract Liquid Matching Pants', asset('763259a4d3de313440af517f89eafdcc', 'Pants'), 1],
            ['Verified, Bonafide, Plaidafied', asset('c40f0c0a9d251e455b2b454640db204d', 'Hat'), 0],
            ['Starwisp', asset('86be7a76d785a24b5afb124f69281b08', 'ShoulderAccessory'), 0],
            ['Boy', outfit('992F7E86023A40FB916158CC305569AD', 'Avatar'), 0],
            ['Man', outfit('F89FD29562C7FECBB8600EC01AF0C328', 'Avatar'), 0],
            ['Stevie Standard', outfit('DEDA5A3711A759312A2AE54E64C90182', 'DynamicHeadCostume'), 0],
            ['Man Face', outfit('4A3780D132A6B7CA6BCD3793C52F4DFA', 'DynamicHeadCostume'), 0],
            ['Rthro Animation Package', outfit('74142E5A123B951377F3828FD7E0FA52', 'Avatar'), 0],
            ['Brown Hair', asset('2579acf81b849c7c583c0e733dc2db94', 'HairAccessory'), 0],
            ['Black Jeans with Sneakers', asset('6b8db16d7f5c57f1017a6110be0c490a', 'Pants'), 0],
            ['Guitar Tee with Black Jacket', asset('fd315accbd6a31cfd3ab519a529ca767', 'Shirt'), 0],
            ['Green Jersey', asset('6c9577df697d024001bdbab529eead72', 'Shirt'), 0],
            ['Jean Shorts with White Shoes', asset('aa0e960ad43d13fa2f58764ca257d475', 'Pants'), 0],
            ['Brown Charmer Hair', asset('dfbceeb2533c14c862a3934fe2b88980', 'HairAccessory'), 0],
            ['Stylish Aviators', asset('7c00c3dec8f612cfd6118b7e8aa20ea6', 'FaceAccessory'), 0],
            ['Blonde Spiked Hair', asset('84810ac108a5fbd2f7bd66e6b7ae09fa', 'HairAccessory'), 0],
            ['Dark Green Jeans', asset('271360eb1523e4c8cb9ae56fadd7a354', 'Pants'), 0],
            ['Blue and Black Motorcycle Shirt', asset('a363b433a6b1ca1717f38c2c83e92738', 'Shirt'), 0],
            ['Pal Hair', asset('9584b86683630361b51f29117503044f', 'HairAccessory'), 0],
            ['Bloxxer', asset('1f7190ac47676f7f10659b2b3dda2d19', 'Tshirt'), 0]
        ];
        var TABS = [['recent', 'Recent', 'Recently Added', 1], ['avatars', 'Avatars', 'Costumes', 1], ['body', 'Body', 'Skin Tone', 1], ['makeup', 'Makeup', 'Face Makeup', 1],
            ['clothing', 'Clothing', 'Shirts', 1], ['accessories', 'Accessories', 'Hats', 1], ['backgrounds', 'Backgrounds', 'Backgrounds', 0], ['animations', 'Animations', 'Idle', 1]];
        var COLORS = ['90,76,66', '124,92,70', '175,148,131', '204,142,105', '234,184,146', '86,66,54', '105,64,40', '188,155,93', '199,172,120', '215,197,154', '149,121,119', '163,75,75', '218,134,122', '255,201,201',
            '255,152,220', '116,134,157', '82,124,174', '128,187,220', '177,167,255', '167,94,155', '0,143,156', '91,154,76', '124,156,107', '161,196,140', '226,155,64', '245,205,48', '248,217,109', '99,95,98', '205,205,205', '248,248,248'];
        var SCALES = [['height', 'Height', 90, 105, 100], ['width', 'Width', 70, 100, 100], ['head', 'Head', 95, 100, 100], ['proportions', 'Proportions', 0, 100, 0]];
        var tab = 'recent', pic = 0;
        function me() { return rbxShell.currentAccount() || acc; }
        function equipped() { var a = me(); return Array.isArray(a.avatarEquipped) ? a.avatarEquipped : ITEMS.filter(function (i) { return i[2]; }).map(function (i) { return i[0]; }); }
        function scaleOf(id, d) { var s = me().avatarScale || {}; return typeof s[id] === 'number' ? s[id] : d; }
        function avatarSrc() { var a = me(); return (window.avatarFileForAccount ? window.avatarFileForAccount(a) : '') + (pic ? '?r=' + pic : ''); }

        function tabBody() {
            var eq = equipped();
            if (tab === 'recent') {
                return '<div class="tab-pane active" id="recent"><div id="avatar-items-container"><div class="items-list avatar-item-list"><ul class="hlist item-cards-stackable">' + ITEMS.map(function (it, i) {
                    var on = eq.indexOf(it[0]) !== -1;
                    return '<li class="list-item item-card seven-column"><div class="item-card-container remove-panel' + (on ? ' is-equipped' : '') + '" role="button" tabindex="0" aria-pressed="' + on + '" data-item="' + i + '">' +
                        '<div class="item-card-link"><div class="item-card-thumb-container"><div class="item-card-thumb"><span class="thumbnail-2d-container float-left overflow-hidden" style="display:block;width:100%;height:100%;"><img class="size-full" src="' + esc(it[1]) + '" alt=""></span></div></div></div>' +
                        (on ? '<span class="rbxtest-eq" aria-label="Equipped">&#10003;</span>' : '') +
                        '<div class="item-card-caption"><div title="' + esc(it[0]) + '" class="text-overflow item-card-name">' + esc(it[0]) + '</div></div></div></li>';
                }).join('') + '</ul></div></div></div>';
            }
            if (tab === 'body') {
                var sel = me().avatarBodyColor || '';
                return '<div class="tab-pane active" id="bodyColors"><div class="section-content"><div class="bodycolors-list">' + COLORS.map(function (c) {
                    return '<div class="color-dot' + (sel === c ? ' selected' : '') + '" role="button" tabindex="0" aria-label="Skin tone ' + c + '" data-color="' + c + '" style="background-color: rgb(' + c + ');"></div>';
                }).join('') + '</div></div><div class="section-content scaling-tab" id="scale"><h4 class="scaling-info">Scaling</h4><div class="section-sliders">' + SCALES.map(function (s) {
                    var v = scaleOf(s[0], s[4]);
                    return '<div class="scale-container"><div class="text-label font-subheader-1">' + s[1] + '</div><input type="range" min="' + s[2] + '" max="' + s[3] + '" value="' + v + '" data-scale="' + s[0] + '" aria-label="' + s[1] + '"><div class="scale-label font-body" data-scale-label="' + s[0] + '">' + v + '%</div></div>';
                }).join('') + '</div></div></div>';
            }
            return '<div class="tab-pane active"><div id="avatar-items-container"><div class="items-list avatar-item-list"><div class="col-xs-12 section-content-off"><div>You don\'t have this item: ' + esc(TABS.filter(function (t) { return t[0] === tab; })[0][2]) + '</div></div></div></div></div>';
        }
        function render() {
            var cur = TABS.filter(function (t) { return t[0] === tab; })[0];
            root.innerHTML = '<div class="content seven-column" data-avatar-columns="7"><div id="avatar-web-app" class="row page-content"><div avatar-base=""></div><div id="avatar-react-container"><div>' +
                '<div class="avatar-editor-header"><h1>Avatar Editor</h1><div class="catalog-header"><div>Explore the marketplace to find more clothes!</div><a href="#" class="btn-primary-md" data-soon>Get More</a></div></div>' +
                '<div class="avatar-layout"><div class="left-wrapper-placeholder"><div class="left-wrapper"><div class="section-content remove-panel"><div class="avatar-back"><div class="avatar-thumbnail">' +
                '<div id="UserAvatar" class="thumbnail-holder delayed-thumbnail-holder"><span class="thumbnail-2d-container" style="display:block;width:100%;height:100%;"><img class="avatar-preview" alt="Your avatar" src="' + esc(avatarSrc()) + '"></span></div>' +
                '<button type="button" class="toggle-three-dee" data-three>3D</button></div></div></div>' +
                '<div class="redraw-avatar"><span>Avatar isn\'t loading correctly?</span><button class="text-link" type="button" data-redraw>Redraw</button></div></div></div>' +
                '<div class="right-panel seven-column"><div class="right-wrapper right-wrapper-seven-column"><div class="tab-wrapper"><div class="rbx-tabs-horizontal rbx-tabs-horizontal-seven-column avatar-tabs-scroller"><ul id="horizontal-tabs" class="nav nav-tabs" role="tablist">' +
                TABS.map(function (t) { return '<li class="rbx-tab seven-tab' + (t[0] === tab ? ' active' : '') + '" role="presentation"><button type="button" class="rbx-tab-heading" role="tab" aria-selected="' + (t[0] === tab) + '" data-tab="' + t[0] + '"><span class="text-lead">' + t[1] + '</span></button></li>'; }).join('') +
                '</ul></div></div></div><div class="tab-content rbx-tab-content"><div id="tab-content-top"></div><ul class="breadcrumb-container"><li>' + cur[1] + '</li><li>&rsaquo;</li><li>' + cur[2] + '</li></ul>' + tabBody() + '</div></div></div></div></div></div></div></div>';
        }
        root.addEventListener('click', function (e) {
            var t = e.target; if (!t.closest) return;
            var tb = t.closest('[data-tab]');
            if (tb) { tab = tb.getAttribute('data-tab'); return render(); }
            var it = t.closest('[data-item]');
            if (it) {
                var name = ITEMS[+it.getAttribute('data-item')][0], eq = equipped().slice(), i = eq.indexOf(name);
                if (i === -1) eq.push(name); else eq.splice(i, 1);
                rbxShell.saveAccount(key, { avatarEquipped: eq }); return render();
            }
            var cd = t.closest('[data-color]');
            if (cd) { rbxShell.saveAccount(key, { avatarBodyColor: cd.getAttribute('data-color') }); return render(); }
            if (t.closest('[data-three]')) return rbxShell.toast('3D preview coming soon');
            if (t.closest('[data-redraw]')) { pic = Date.now(); var im = root.querySelector('.avatar-preview'); if (im) im.src = avatarSrc(); return rbxShell.toast('Avatar redrawn'); }
            if (t.closest('[data-soon]')) { e.preventDefault(); return rbxShell.toast('Coming soon'); }
        });
        root.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            var el = e.target.closest && e.target.closest('[data-item], [data-color]');
            if (el && e.target === el) { e.preventDefault(); el.click(); }
        });
        root.addEventListener('input', function (e) {
            var r = e.target; if (!r.hasAttribute || !r.hasAttribute('data-scale')) return;
            var id = r.getAttribute('data-scale'), s = Object.assign({}, me().avatarScale || {});
            s[id] = +r.value; rbxShell.saveAccount(key, { avatarScale: s });
            var l = root.querySelector('[data-scale-label="' + id + '"]'); if (l) l.textContent = r.value + '%';
        });
        render();
    });
});
</script>


