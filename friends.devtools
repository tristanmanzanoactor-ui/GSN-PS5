<style id="rbxtest-profileview-styles">
html.rbx-auth-pending body { visibility: hidden; }
.profile-avatar { width: 100%; height: 100%; object-fit: cover; display: block; }
[data-rbx-avatar] { display: block !important; position: relative !important; overflow: hidden !important; border-radius: inherit; background-image: none !important; }
[data-rbx-avatar]::before, [data-rbx-avatar]::after { display: none !important; content: none !important; }
[data-rbx-avatar] > img.profile-avatar { display: block !important; visibility: visible !important; opacity: 1 !important; width: 100% !important; height: 100% !important; max-width: none !important; object-fit: cover !important; position: relative; z-index: 1; }

[hidden] { display: none !important; }
/* Profile header is a normal (non-clickable) block; only its real links/buttons are interactive */
#profile-area a, #profile-area button.more-btn, #profile-area .buttons-show-on-desktop button, #profile-area .buttons-show-on-mobile button { cursor: pointer; }
.profile-header-main { flex: 1 1 auto; color: inherit; font: inherit; text-align: left; }
/* About / Creations / Currently Wearing are always visible, stacked under the header */
#profile-details { display: block; }
#profile-details .profile-section { padding-top: 24px; }
#profile-details .profile-section-title { margin: 0 0 12px; }
#profile-details .profile-about-text { margin: 0; white-space: pre-wrap; font: inherit; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
/* Presence (online) icon: FigureBlox's own .icon-online styling is used; this only keeps it on top of the avatar */
.avatar-card-fullbody, .avatar-headshot-lg .avatar { position: relative; }
.avatar-card-fullbody > .avatar-status { position: absolute; right: 0; bottom: 0; z-index: 5; line-height: 0; pointer-events: none; }
/* only applied by script if FigureBlox's stylesheet did not load (icon would otherwise be invisible) */
.avatar-status.presence-fallback [data-testid="presence-icon"] { display: block; width: 18px; height: 18px; box-sizing: border-box; border-radius: 50%; background: #00b06f; border: 3px solid var(--color-surface-0, #fff); }
/* Profile details: About / Creations tabs (About is selected by default) */
#profile-details, #profile-details[hidden] { display: block !important; visibility: visible !important; }
#profile-details .profile-tabs { list-style: none; margin: 0; padding: 0; display: flex; border-bottom: 1px solid var(--color-divider, rgba(128,128,128,.4)); }
#profile-details .profile-tabs li { flex: 1 1 0; display: flex; justify-content: center; }
#profile-details .profile-tab { text-decoration: none; cursor: pointer; color: inherit; opacity: .75; }
#profile-details .profile-tab.active { opacity: 1; font-weight: 700; box-shadow: inset 0 -2px 0 currentColor; }
#profile-details .profile-tab-content[hidden] { display: none !important; }
#profile-details .profile-empty { margin: 0; opacity: .7; }
.css-1jynqc0-carouselContainer { position: relative; }
.css-1i465w8-carousel { scroll-behavior: smooth; }
.scroll-arrow { position: absolute; top: 50%; right: 0; transform: translateY(-50%); cursor: pointer; z-index: 3; }
.scroll-arrow[hidden] { display: none !important; }
.scroll-arrow.arrow-fallback { width: 36px; height: 36px; border-radius: 50%; background: rgba(40,40,40,.85); color: #fff; display: flex; align-items: center; justify-content: center; }
.scroll-arrow.arrow-fallback .icon-chevron-heavy-right::before { content: "\203A"; font-size: 26px; line-height: 1; }
/* "more" -> About dialog */
.rbxtest-dialog-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100000; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(0,0,0,.6); }
.rbxtest-dialog { position: relative; width: 100%; max-width: 480px; max-height: 85vh; overflow: auto; border-radius: 12px; background: var(--color-surface-0, #fff); color: var(--color-content-default, inherit); }
.rbxtest-dialog-close { position: absolute; top: 8px; right: 12px; z-index: 1; background: none; border: 0; padding: 0 4px; font-size: 28px; line-height: 1; color: inherit; cursor: pointer; }
.rbxtest-dialog .edit-bio-btn { background: none; border: 0; padding: 0; margin-top: 8px; cursor: pointer; color: inherit; text-decoration: underline; }
.profile-platform-container[hidden], #edit-user-profile-web-app[hidden] { display: none !important; }
.profile-setting-row { text-align: left; }
.profile-setting-row-value { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rbxtest-dialog [data-profile-about] { white-space: pre-wrap; overflow-wrap: anywhere; }
#profile-area pre.description-content { white-space: pre-wrap; overflow-wrap: anywhere; }
.rbxtest-frame-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; z-index: 6; }
.rbxtest-frame-tile { width: 92px; padding: 10px 6px; border: 2px solid rgba(128,128,128,.4); border-radius: 12px; background: none; color: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; font: inherit; }
.rbxtest-frame-tile[aria-pressed="true"] { border-color: #335fff; }
.rbxtest-frame-thumb { width: 56px; height: 56px; border-radius: 50%; border: 2px dashed rgba(128,128,128,.6); display: flex; align-items: center; justify-content: center; font-size: 24px; opacity: .8; }
/* fallback layout for the Currently Wearing carousel (its styles are normally injected by FigureBlox's scripts) */
.css-1i465w8-carousel { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }
.css-izzd58-carouselItem, .css-6xn1qo-carouselItem { flex: 0 0 150px; width: 150px; }

</style>
<script src="shell.js" defer></script>
<script id="rbxtest-avatar-detect">
/* AVATAR DETECTION SCRIPT
   Signup saves account.selectedCharacter = "male" | "female" (see index.html).
   This script detects the logged-in account, reads that saved choice and puts the matching avatar URL
   (male -> proud-river worker, female -> green-leaf worker) into the <img> inside EVERY
   .thumbnail-2d-container.avatar-card-image on the page, now and whenever the site redraws one. */
(function () {
    var URLS = {
        male: 'https://proud-river-a3e7.tristan-manzano-actor.workers.dev/',
        female: 'https://green-leaf-a836.tristan-manzano-actor.workers.dev/'
    };
    var SELECTOR = '.thumbnail-2d-container.avatar-card-image';
    var EXTRA = 'a[href="/users/profile"] .thumbnail-2d-container, a[href^="/users/"][href$="/profile"] .thumbnail-2d-container, #header .avatar-headshot .thumbnail-2d-container, #header .avatar-headshot-xs .thumbnail-2d-container';

    function readJSON(storage, key) {
        try { return JSON.parse(storage.getItem(key)); } catch (e) { return null; }
    }
    // 1) the current logged-in account (session -> saved account)
    function detectCurrentAccount() {
        var session = readJSON(sessionStorage, 'rbxtest_session') || readJSON(localStorage, 'rbxtest_session');
        if (!session || !session.username) return null;
        var accounts = readJSON(localStorage, 'rbxtest_accounts') || {};
        return accounts[session.username] || null;
    }
    // 2) its saved selectedCharacter -> the avatar URL
    function avatarFileForAccount(account) {
        var choice = String((account && (account.selectedCharacter || account.character)) || '').toLowerCase();
        return choice === 'female' ? URLS.female : URLS.male;
    }

    function setAvatar(container, file) {
        var only = container.children.length === 1 ? container.firstElementChild : null;
        if (only && only.tagName === 'IMG' && only.getAttribute('data-avatar-file') === file ) return;   // already correct
        var img = document.createElement('img');
        img.className = 'profile-avatar';
        img.setAttribute('data-avatar-file', file);
        img.alt = 'FigureBlox avatar';
        img.src = file;
        container.setAttribute('data-rbx-avatar', 'true');
        Array.prototype.slice.call(container.classList).forEach(function (c) {
            if (/shimmer|loading|broken|placeholder/i.test(c)) container.classList.remove(c);
        });
        container.replaceChildren(img);
    }
    // 3) put the PNG into both (all) avatar locations
    function loadAccountAvatar(currentAccount) {
        currentAccount = currentAccount || detectCurrentAccount();
        if (!currentAccount) return;
        var file = avatarFileForAccount(currentAccount);
        var seen = [];
        var list = Array.prototype.slice.call(document.querySelectorAll(SELECTOR))
            .concat(Array.prototype.slice.call(document.querySelectorAll(EXTRA)));
        list.forEach(function (container) {
            if (seen.indexOf(container) !== -1) return;
            seen.push(container);
            setAvatar(container, file);
        });
    }
    window.detectCurrentAccount = detectCurrentAccount;
    window.avatarFileForAccount = avatarFileForAccount;
    window.loadAccountAvatar = loadAccountAvatar;

    // run now, when the DOM is ready, when everything has loaded, and whenever the site re-renders an avatar
    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        (window.requestAnimationFrame || setTimeout)(function () { queued = false; loadAccountAvatar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule); else schedule();
    window.addEventListener('load', schedule);
    new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script id="rbxtest-friends">
document.documentElement.classList.add('rbx-auth-pending');
document.addEventListener('DOMContentLoaded', function () {
    rbxShell.requireLogin(function (acc, key) {
        document.title = 'Friends - FigureBlox';
        var root = document.getElementById('page-root');
        var esc = rbxShell.esc;
        var TABS = [['friends', 'Friends', '#!/friends'], ['following', 'Following', '#!/following'], ['followers', 'Followers', '#!/followers'], ['requests', 'Requests', '#!/friend-requests'], ['global', 'Global', '#!/global']];
        var BY_HASH = { '#!/friends': 'friends', '#!/following': 'following', '#!/followers': 'followers', '#!/friend-requests': 'requests', '#!/global': 'global' };
        var BTN = 'foundation-web-button relative clip group/interactable focus-visible:outline-focus disabled:outline-none cursor-pointer relative flex items-center justify-center stroke-none padding-y-none select-none radius-medium text-label-medium height-1000 padding-x-medium bg-action-standard content-action-standard width-full player-search-action-parity';
        var query = '', lastSig = '';

        function tabName() { return BY_HASH[location.hash] || 'friends'; }
        // every account except banned ones (banned accounts never show up in Global, Friends, Requests or search)
        function allAccounts() {
            return rbxShell.visibleAccounts().sort(function (a, b) { return String(a.created || '').localeCompare(String(b.created || '')); });
        }
        // a short fingerprint of who is listed, so a new signup / a ban is noticed immediately
        function signature() {
            return allAccounts().map(function (a) { return String(a.username).toLowerCase() + ':' + (a.displayName || '') + ':' + (a.selectedCharacter || '') + ':' + (rbxShell.friendsOf(a).length) + ':' + (rbxShell.pendingRequests(a).length); }).join('|');
        }
        function avatarFor(a) { return window.avatarFileForAccount ? window.avatarFileForAccount(a) : ''; }
        function statusHTML(a) {
            var on = rbxShell.isOnline(a.username);
            return '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:' + (on ? '#00b06f' : '#8a8d94') + ';"></span>' + (on ? 'Online' : 'Offline');
        }
        // the verified check is only shown while the verified account is online
        function badgeHTML(a) { return rbxShell.isVerified(a) && rbxShell.isOnline(a.username) ? rbxShell.verifiedHTML : ''; }
        var ABTN = 'width:100%;height:40px;border:0;border-radius:8px;background:rgba(128,128,128,.22);color:inherit;font:inherit;font-weight:600;cursor:pointer;';
        function actionHTML(a, mode) {
            var u = esc(a.username), mine = rbxShell.currentAccount() || {};
            if (mode === 'request') {
                return '<div style="display:flex;gap:8px;"><button type="button" class="' + BTN + '" data-accept="' + u + '" style="' + ABTN + 'background:#335fff;color:#fff;">Accept</button>' +
                    '<button type="button" class="' + BTN + '" data-decline="' + u + '" style="' + ABTN + '">Decline</button></div>';
            }
            if (rbxShell.isFriend(mine, a.username)) return '<button type="button" class="' + BTN + '" disabled style="' + ABTN + 'opacity:.6;cursor:default;">Friends</button>';
            if (rbxShell.pendingRequests(mine).some(function (r) { return r.from === String(a.username).toLowerCase(); })) return '<button type="button" class="' + BTN + '" data-accept="' + u + '" style="' + ABTN + 'background:#335fff;color:#fff;">Accept request</button>';
            if (rbxShell.pendingRequests(a).some(function (r) { return r.from === key; })) return '<button type="button" class="' + BTN + '" disabled style="' + ABTN + 'opacity:.6;cursor:default;">Request sent!</button>';
            return '<button type="button" class="' + BTN + '" data-add="' + u + '" style="' + ABTN + '">Add friend</button>';
        }
        function card(a, mode) {
            var me = String(a.username).toLowerCase() === key;
            return '<article class="player-search-card" role="link" tabindex="0" data-profile="' + esc(a.username) + '" data-testid="player-card-' + esc(a.username) + '" style="display:flex;flex-direction:column;cursor:pointer;border:1px solid rgba(128,128,128,.4);border-radius:12px;background:rgba(128,128,128,.08);">' +
                '<div class="player-search-card-body" style="display:flex;align-items:flex-start;gap:16px;padding:16px;">' +
                '<span class="player-search-avatar" style="flex:none;width:60px;height:60px;border-radius:50%;overflow:hidden;background:rgba(128,128,128,.25);display:block;"><img class="height-full width-full object-cover" src="' + esc(avatarFor(a)) + '" alt="' + esc(a.username) + '" style="width:100%;height:100%;object-fit:cover;"></span>' +
                '<div class="player-search-card-caption" style="min-width:0;display:flex;flex-direction:column;gap:2px;">' +
                '<div class="player-search-card-name text-body-large content-emphasis" style="display:flex;align-items:center;"><span class="text-truncate-end" style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + esc(rbxShell.displayName(a)) + '</span><span class="badge-slot" style="display:inline-flex;">' + badgeHTML(a) + '</span>' + rbxShell.plusHTML + '</div>' +
                '<p class="text-body-small content-muted" style="margin:0;">@' + esc(a.username) + '</p>' +
                '<p class="text-body-small content-muted presence-line" style="margin:0;display:flex;align-items:center;">' + statusHTML(a) + '</p></div></div>' +
                (me ? '' : '<div class="player-search-actions" style="padding:0 16px 16px;">' + actionHTML(a, mode) + '</div>') +
                '</article>';
        }
        // keep Online / Offline and the verified check current without redrawing the page (so typing in search is not interrupted)
        function refreshPresence() {
            var all = {};
            allAccounts().forEach(function (x) { all[String(x.username).toLowerCase()] = x; });
            root.querySelectorAll('[data-profile]').forEach(function (c) {
                var a = all[String(c.getAttribute('data-profile')).toLowerCase()];
                if (!a) return;
                var line = c.querySelector('.presence-line'), slot = c.querySelector('.badge-slot');
                var st = statusHTML(a), bd = badgeHTML(a);
                if (line && line.innerHTML !== st) line.innerHTML = st;
                if (slot && slot.innerHTML !== bd) slot.innerHTML = bd;
            });
        }
        function render() {
            var searchBox = document.getElementById('friends-search');
            var hadFocus = !!searchBox && document.activeElement === searchBox;
            var caret = hadFocus ? searchBox.selectionStart : 0;
            var t = tabName();
            var title = TABS.filter(function (x) { return x[0] === t; })[0][1];
            var tabsHTML = TABS.map(function (x) {
                var on = x[0] === t;
                return '<li role="tab" class="rbx-tab" style="list-style:none;flex:1;text-align:center;"><a class="rbx-tab-heading' + (on ? ' active' : '') + '" href="' + x[2] + '"' + (on ? ' aria-current="page"' : '') + ' style="display:block;padding:14px 8px;text-decoration:none;color:inherit;font-weight:' + (on ? 700 : 500) + ';border-bottom:3px solid ' + (on ? 'currentColor' : 'transparent') + ';"><span class="text-lead">' + x[1] + '</span></a></li>';
            }).join('');
            var list = [], count = 0, mode = '';
            var byKey = {}; allAccounts().forEach(function (x) { byKey[String(x.username).toLowerCase()] = x; });
            var me = rbxShell.currentAccount() || acc;
            if (t === 'global') {
                var q = query.trim().toLowerCase();
                list = allAccounts().filter(function (a) { return !q || String(a.username).toLowerCase().indexOf(q) !== -1 || rbxShell.displayName(a).toLowerCase().indexOf(q) !== -1; });
                count = allAccounts().length;
            } else if (t === 'friends') {
                list = rbxShell.friendsOf(me).map(function (u) { return byKey[u]; }).filter(Boolean);
                count = list.length;
            } else if (t === 'requests') {
                list = rbxShell.pendingRequests(me).map(function (r) { return byKey[r.from]; }).filter(Boolean);
                count = list.length; mode = 'request';
            }
            var body = list.length
                ? '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin-top:16px;">' + list.map(function (a) { return card(a, mode); }).join('') + '</div>'
                : '<div class="section-content-off" style="padding:24px 0;">No results found.</div>';
            var chips = t === 'friends' ? '<div class="chip-filters-container" style="display:flex;gap:8px;margin-top:12px;">' +
                '<button type="button" aria-pressed="true" style="height:32px;padding:0 16px;border:0;border-radius:16px;background:#232527;color:#fff;font:inherit;font-weight:600;cursor:pointer;">All</button>' +
                '<button type="button" aria-pressed="false" style="height:32px;padding:0 16px;border:0;border-radius:16px;background:rgba(128,128,128,.22);color:inherit;font:inherit;font-weight:600;cursor:pointer;">Trusted</button></div>' : '';
            root.innerHTML = '<div class="row page-content" style="max-width:970px;margin:0 auto;padding:16px;">' +
                '<div class="page-header section"><div class="container-header"><h1 class="friends-title" style="margin:0 0 12px;">My Friends</h1></div></div>' +
                '<div class="rbx-tabs-horizontal"><ul class="nav nav-tabs" role="tablist" style="display:flex;margin:0;padding:0;border-bottom:1px solid rgba(128,128,128,.4);">' + tabsHTML + '</ul>' +
                '<div class="tab-content rbx-tab-content"><div role="tabpanel" class="tab-pane active"><div class="friends-content section" style="padding-top:16px;">' +
                '<div class="container-header"><div class="friends-subtitle" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:space-between;"><h2 style="margin:0;">' + title + ' (' + count + ')</h2>' +
                '<div class="friends-filter"><div class="friends-filter-searchbar-container form-control input-field" style="display:flex;align-items:center;gap:8px;border:1px solid rgba(128,128,128,.5);border-radius:8px;padding:0 12px;height:36px;"><span class="icon-search"></span><input id="friends-search" class="friends-filter-searchbar-input" type="text" placeholder="Search ' + (t === 'global' ? 'Global' : title) + '" value="' + esc(query) + '" style="background:none;border:0;outline:0;color:inherit;font:inherit;"></div></div></div>' + chips + '</div>' +
                body + '</div></div></div></div></div>';
            var input = document.getElementById('friends-search');
            input.addEventListener('input', function () {
                query = input.value;
                var pos = input.selectionStart;
                render();
                var n = document.getElementById('friends-search'); n.focus(); n.setSelectionRange(pos, pos);
            });
            if (hadFocus) { input.focus(); try { input.setSelectionRange(caret, caret); } catch (e) {} }
            lastSig = signature();
        }
        function openProfile(c) {
            var u = c.getAttribute('data-profile');
            window.location.href = 'profileview.devtools' + (String(u).toLowerCase() === key ? '' : '?u=' + encodeURIComponent(u));
        }
        root.addEventListener('click', function (e) {
            if (!e.target.closest) return;
            var add = e.target.closest('[data-add]'), acc_ = e.target.closest('[data-accept]'), dec = e.target.closest('[data-decline]');
            if (add) {
                var r = rbxShell.sendFriendRequest(add.getAttribute('data-add'));
                rbxShell.toast(r === 'sent' ? 'Request sent!' : r === 'already-sent' ? 'Request already sent' : 'Could not send request');
                return render();
            }
            if (acc_) { rbxShell.acceptRequest(acc_.getAttribute('data-accept')); rbxShell.sync(); rbxShell.toast('Friend request accepted'); return render(); }
            if (dec) { rbxShell.declineRequest(dec.getAttribute('data-decline')); rbxShell.sync(); return render(); }
            var c = e.target.closest('[data-profile]');
            if (c) openProfile(c);   // anywhere in the rectangle opens that player's profile
        });
        root.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' || !e.target.closest) return;
            var c = e.target.closest('[data-profile]');
            if (c && e.target === c) openProfile(c);
        });
        setInterval(refreshPresence, 5000);
        // INSTANT updates: another tab's signup / ban fires a storage event (redraws now, even while typing in the search box);
        // a 1-second fingerprint check is the safety net, and the page also redraws as soon as the tab is shown again.
        window.addEventListener('storage', function () { render(); });
        setInterval(function () { if (signature() !== lastSig) render(); }, 1000);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) render(); });
        window.addEventListener('storage', refreshPresence);
        window.addEventListener('hashchange', function () { query = ''; render(); });
        render();
    });
});
</script>

